flowchart LR
start["Настройки магазинов"] --> market{"Маркетплейс"}
market -->|"WB"| wb["API-ключ"]
market -->|"Ozon"| oz["API-ключ и Client ID"]
wb --> verify{"Проверка реквизитов"}
oz --> verify
verify -->|"Ошибка"| retry["Исправить реквизиты"]
retry --> market
verify -->|"Успех"| name["Получить название магазина"]
name --> cabinet["Выбрать подключённый кабинет"]
cabinet --> warehouse["Выбрать один склад"]
warehouse --> code["Сгенерировать одноразовый код"]
code --> share["Передать код фулфилменту"]
code --> revoke["Отменить или перевыпустить код"]
share --> input["Фулфилмент вводит только код"]
input --> valid{"Код действителен и не использован?"}
valid -->|"Нет"| error["Код не найден, отменён или использован"]
valid -->|"Да"| limit{"Есть место в подписке?"}
limit -->|"Нет"| upgrade["Увеличить лимит кабинетов"]
limit -->|"Да"| consume["Активировать код один раз"]
consume --> scope["Доступ только к выбранному кабинету и складу"]
scope --> dashboard["Дашборд клиента и фулфилмента"]
