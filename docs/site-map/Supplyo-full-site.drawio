  <diagram id="p09" name="09 · Новые заказы → новая / существующая поставка">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title-09" value="09 · Новые заказы → новая / существующая поставка" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=34;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="70" y="20" width="1360" height="65" as="geometry" />
        </mxCell>
        <mxCell id="scope-09" value="Владелец / сотрудник с правом поставок" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=21;fontColor=#64748B;" parent="1" vertex="1">
          <mxGeometry x="70" y="90" width="1360" height="45" as="geometry" />
        </mxCell>
        <mxCell id="status-09" value="Реализация: Создание новой поставки и добавление заказов в существующую реализованы." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=18;fontColor=#64748B;" parent="1" vertex="1">
          <mxGeometry x="70" y="140" width="1360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="09-context" value="ВЫБОР КОНТЕКСТА&#10;Кабинет + один склад WB.&#10;Для доступа клиента склад уже&#10;ограничен выданным доступом." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="553.3333333333333" y="280" width="460" height="184" as="geometry" />
        </mxCell>
        <mxCell id="09-list" value="НОВЫЕ ЗАКАЗЫ&#10;Номер заказа, товар, баркоды, склад&#10;WB, дата.&#10;Поиск по номеру / артикулу / баркоду.&#10;Код и адрес здесь не показываются." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="553.3333333333333" y="584" width="460" height="212" as="geometry" />
        </mxCell>
        <mxCell id="09-select" value="ВЫБРАТЬ ЗАКАЗЫ&#10;По одному или все показанные.&#10;Счётчик в кнопке; сетка не смещается." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="553.3333333333333" y="916" width="460" height="156" as="geometry" />
        </mxCell>
        <mxCell id="09-existing" value="ДОБАВИТЬ В ПОСТАВКУ&#10;Только открытая поставка того же&#10;кабинета и склада. Если их несколько&#10;— выбрать.&#10;Без подходящей поставки кнопка&#10;неактивна." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="630" y="1192" width="460" height="240" as="geometry" />
        </mxCell>
        <mxCell id="09-new" value="СОЗДАТЬ ПОСТАВКУ&#10;Новая поставка для выбранных&#10;заказов одного склада.&#10;Не смешивать кабинеты и склады." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="70" y="1220" width="460" height="184" as="geometry" />
        </mxCell>
        <mxCell id="09-check" value="Можно добавить&#10;все выбранные заказы?" style="rhombus;whiteSpace=wrap;html=0;fillColor=#FFF0C9;strokeColor=#C99726;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="553.3333333333333" y="1552" width="460" height="220" as="geometry" />
        </mxCell>
        <mxCell id="09-error" value="ЗАКАЗ ИЗМЕНИЛСЯ&#10;Уже добавлен / отменён / другой склад&#10;/ нет прав.&#10;Показать причину, обновить список." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#FFE3DE;strokeColor=#D37D6A;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="70" y="2038" width="460" height="184" as="geometry" />
        </mxCell>
        <mxCell id="09-wb" value="ЗАПРОС В WB&#10;Создать / использовать поставку →&#10;добавить только выбранные ID&#10;заказов.&#10;Повтор запроса не создаёт дубликат." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="630" y="2038" width="460" height="212" as="geometry" />
        </mxCell>
        <mxCell id="09-pending" value="ЧАСТИЧНЫЙ ОТВЕТ / СБОЙ&#10;Сверить результат с WB.&#10;Не объявлять успех и не создавать&#10;вторую поставку вслепую." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#FFF0C9;strokeColor=#C99726;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="185" y="2516" width="460" height="184" as="geometry" />
        </mxCell>
        <mxCell id="09-done" value="ЗАКАЗЫ ДОБАВЛЕНЫ&#10;Уходят из новых заказов.&#10;Поставка открывается в сборке → 10." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#DFF4E4;strokeColor=#65A773;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="745" y="2516" width="460" height="156" as="geometry" />
        </mxCell>
        <mxCell id="09-edge-0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontColor=#233044;fontSize=18;fontFamily=Arial;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;exitPerimeter=0;entryPerimeter=0;" parent="1" edge="1" source="09-context" target="09-list">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="09-edge-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontColor=#233044;fontSize=18;fontFamily=Arial;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;exitPerimeter=0;entryPerimeter=0;" parent="1" edge="1" source="09-list" target="09-select">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="09-edge-2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontColor=#233044;fontSize=18;fontFamily=Arial;labelBackgroundColor=#FFFFFF;exitX=0.6666666666666669;exitY=1.0;entryX=0.5;entryY=0.0;exitPerimeter=0;entryPerimeter=0;" parent="1" edge="1" source="09-select" target="09-existing">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="09-edge-3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontColor=#233044;fontSize=18;fontFamily=Arial;labelBackgroundColor=#FFFFFF;exitX=0.3333333333333334;exitY=1.0;entryX=0.5;entryY=0.0;exitPerimeter=0;entryPerimeter=0;" parent="1" edge="1" source="09-select" target="09-new">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="706.6666666666666" y="1110" />
              <mxPoint x="300" y="1110" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="09-edge-4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontColor=#233044;fontSize=18;fontFamily=Arial;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1.0;entryX=0.6666666666666669;entryY=0.16666666666666702;exitPerimeter=0;entryPerimeter=0;" parent="1" edge="1" source="09-existing" target="09-check">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="09-edge-5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontColor=#233044;fontSize=18;fontFamily=Arial;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1.0;entryX=0.3333333333333334;entryY=0.16666666666666702;exitPerimeter=0;entryPerimeter=0;" parent="1" edge="1" source="09-new" target="09-check">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="300" y="1470" />
              <mxPoint x="706.6666666666666" y="1470" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="09-edge-6" value="Нет" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontColor=#233044;fontSize=18;fontFamily=Arial;labelBackgroundColor=#FFFFFF;exitX=0.3333333333333334;exitY=0.833333333333333;entryX=0.5;entryY=0.0;exitPerimeter=0;entryPerimeter=0;" parent="1" edge="1" source="09-check" target="09-error">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="706.6666666666666" y="1810" />
              <mxPoint x="300" y="1810" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="09-edge-7" value="Да" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontColor=#233044;fontSize=18;fontFamily=Arial;labelBackgroundColor=#FFFFFF;exitX=0.6666666666666669;exitY=0.833333333333333;entryX=0.5;entryY=0.0;exitPerimeter=0;entryPerimeter=0;" parent="1" edge="1" source="09-check" target="09-wb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="09-edge-8" value="Неясный результат" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontColor=#233044;fontSize=18;fontFamily=Arial;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1.0;entryX=0.6666666666666667;entryY=0.0;exitPerimeter=0;entryPerimeter=0;" parent="1" edge="1" source="09-wb" target="09-pending">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="860" y="2314" />
              <mxPoint x="491.6666666666667" y="2314" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="09-edge-9" value="Подтверждено" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontColor=#233044;fontSize=18;fontFamily=Arial;labelBackgroundColor=#FFFFFF;exitX=0.75;exitY=1.0;entryX=0.5;entryY=0.0;exitPerimeter=0;entryPerimeter=0;" parent="1" edge="1" source="09-wb" target="09-done">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="09-edge-10" value="Сверка / повтор" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontColor=#233044;fontSize=18;fontFamily=Arial;labelBackgroundColor=#FFFFFF;exitX=0.3333333333333334;exitY=0.0;entryX=0.25;entryY=1.0;exitPerimeter=0;entryPerimeter=0;" parent="1" edge="1" source="09-pending" target="09-wb">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="338.33333333333337" y="2434" />
              <mxPoint x="462.6666666666667" y="2434" />
              <mxPoint x="462.6666666666667" y="2288" />
              <mxPoint x="745" y="2288" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="notes-09" value="Обновление заказов: каждые 60 секунд в фоне без лишних уведомлений. Ручное «Обновить» пропускает обычную минутную паузу, но не реальные ограничения WB. Открытые поставки, созданные напрямую в WB, импортируются общей серверной очередью вместе с составом. Уже закрытая внешняя история целиком не импортируется." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=20;fontColor=#475569;" parent="1" vertex="1">
          <mxGeometry x="70" y="2775" width="1360" height="99" as="geometry" />
        </mxCell>
        <object id="back-09" label="← К оглавлению" link="data:page/id,index">
