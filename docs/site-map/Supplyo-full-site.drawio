  <diagram id="p20" name="20 · Android: сборка на телефоне и общие заметки">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title-20" value="20 · Android: сборка на телефоне и общие заметки" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=34;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="70" y="20" width="2140" height="65" as="geometry" />
        </mxCell>
        <mxCell id="scope-20" value="Владелец / сотрудник с разрешённым магазином и складом" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=21;fontColor=#64748B;" parent="1" vertex="1">
          <mxGeometry x="70" y="90" width="2140" height="45" as="geometry" />
        </mxCell>
        <mxCell id="status-20" value="Реализация: APK 0.2.1. Карточки, локальные отметки, общие заметки и удаление реализованы." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=18;fontColor=#64748B;" parent="1" vertex="1">
          <mxGeometry x="70" y="140" width="2140" height="80" as="geometry" />
        </mxCell>
        <mxCell id="20-apk" value="УСТАНОВИТЬ SUPPLY APK&#10;Android 8+. HTTPS-интерфейс, без&#10;встроенных паролей и ключей WB.&#10;Новая версия подписана тем же&#10;ключом для установки поверх старой." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1397.3333333333333" y="280" width="460" height="212" as="geometry" />
        </mxCell>
        <mxCell id="20-login" value="ВХОД&#10;Та же почта и пароль supply. Сессия —&#10;cookie WebView.&#10;Сайт и APK используют одну&#10;серверную авторизацию." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1397.3333333333333" y="612" width="460" height="212" as="geometry" />
        </mxCell>
        <mxCell id="20-shops" value="ВЫБРАТЬ МАГАЗИН&#10;Только разрешённые собственные /&#10;клиентские / сотруднические&#10;контексты.&#10;Сервер проверяет подписку и&#10;складские права." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1397.3333333333333" y="1090" width="460" height="240" as="geometry" />
        </mxCell>
        <mxCell id="20-supply" value="ВЫБРАТЬ ОТКРЫТУЮ ПОСТАВКУ&#10;Читать данные сайта. Закрытые&#10;поставки не показывать как работу на&#10;сборке." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1474" y="1596" width="460" height="184" as="geometry" />
        </mxCell>
        <mxCell id="20-empty" value="НЕТ ДОСТУПА / ПОСТАВОК / СЕТИ&#10;Понятное сообщение и повтор&#10;загрузки.&#10;Ошибка не создаёт вымышленные&#10;товары." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#FFE3DE;strokeColor=#D37D6A;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="507.33333333333326" y="2260" width="460" height="212" as="geometry" />
        </mxCell>
        <mxCell id="20-cards" value="КОМПАКТНАЯ КАРТОЧКА&#10;Адрес · код · количество крупно в&#10;одной строке. Баркоды ниже.&#10;Товар сгруппирован по баркоду и&#10;размещению, сортировка по адресу.&#10;Название — только в заметках." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1550.6666666666665" y="1900" width="460" height="240" as="geometry" />
        </mxCell>
        <mxCell id="20-gesture" value="ДЕЙСТВИЕ С&#10;КАРТОЧКОЙ?&#10;Одиночный тап не&#10;отмечает.&#10;Прокрутка не&#10;превращается в тап." style="rhombus;whiteSpace=wrap;html=0;fillColor=#FFF0C9;strokeColor=#C99726;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1067.3333333333333" y="2260" width="460" height="408" as="geometry" />
        </mxCell>
        <mxCell id="20-local" value="ДВОЙНОЙ ТАП&#10;Все единицы карточки отмечаются&#10;локально; ещё двойной тап снимает&#10;отметку.&#10;Карточка только зеленеет, без&#10;галочки/подписи и без перемещения." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#DFF4E4;strokeColor=#65A773;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="70" y="2934" width="460" height="240" as="geometry" />
        </mxCell>
        <mxCell id="20-persist" value="ТОЛЬКО ЭТОТ ТЕЛЕФОН&#10;localStorage отдельно по аккаунту,&#10;магазину и поставке.&#10;Перезапуск сохраняет отметки. Статус&#10;WB не ставит и не снимает локальную&#10;отметку." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#F5F6F8;strokeColor=#A5AFBE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="70" y="3294" width="460" height="240" as="geometry" />
        </mxCell>
        <mxCell id="20-swipe" value="СВАЙП ВЛЕВО&#10;Карточка следует за пальцем, короткий&#10;свайп возвращается назад.&#10;Открыть панель заметок снизу." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1144" y="2962" width="460" height="184" as="geometry" />
        </mxCell>
        <mxCell id="20-sheet" value="ЗАМЕТКИ ТОВАРА&#10;Название товара, автор, время и&#10;сообщения сотрудников.&#10;Справа у баркодов маленькая карточка&#10;со счётчиком, если заметки есть." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1144" y="3316.4" width="460" height="212" as="geometry" />
        </mxCell>
        <mxCell id="20-write" value="ДОБАВИТЬ ЗАМЕТКУ&#10;Нужно право assembly. Текст 1–1500&#10;символов.&#10;Автор и время задаются сервером;&#10;повтор запроса использует тот же ID,&#10;без дубля." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1750" y="3800" width="460" height="240" as="geometry" />
        </mxCell>
        <mxCell id="20-shared" value="ОБЩИЕ ЗАМЕТКИ&#10;Отдельная таблица mobile_pick_notes;&#10;видят сотрудники с доступом к этому&#10;складу.&#10;Не изменяют заказы, остатки, КИЗ,&#10;печать или локальные отметки других&#10;телефонов." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#DFF4E4;strokeColor=#65A773;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1673.3333333333333" y="4812" width="460" height="268" as="geometry" />
        </mxCell>
        <mxCell id="20-delete" value="УДАЛИТЬ ЗАМЕТКУ&#10;Корзина → подтверждение / отмена.&#10;Сотрудник удаляет свою, владелец&#10;магазина — любую, при праве&#10;assembly." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="630" y="3809.3333333333335" width="460" height="212" as="geometry" />
        </mxCell>
        <mxCell id="20-deleted" value="ЗАМЕТКА УДАЛЕНА&#10;Исчезает из списка и счётчика. Повтор&#10;удаления безопасен.&#10;Поздний повтор создания не&#10;восстанавливает запись; сервер&#10;проверяет автора и склад." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#DFF4E4;strokeColor=#65A773;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="630" y="4306" width="460" height="240" as="geometry" />
        </mxCell>
        <mxCell id="20-readonly" value="ТОЛЬКО ПРОСМОТР&#10;Без права сборки можно читать&#10;разрешённые заметки, но нельзя&#10;писать или удалять.&#10;Отзыв доступа действует и на прямой&#10;запрос." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#FFF0C9;strokeColor=#C99726;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1190" y="3800" width="460" height="240" as="geometry" />
        </mxCell>
        <mxCell id="20-motion" value="МЯГКИЕ АНИМАЦИИ&#10;Свайп / возврат, панель заметок,&#10;вкладки и подсветка.&#10;Фоновое чтение не перезапускает&#10;появление карточек; reduced-motion&#10;учитывается." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#F5F6F8;strokeColor=#A5AFBE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1627.3333333333333" y="2260" width="460" height="240" as="geometry" />
        </mxCell>
        <object id="20-desktop" label="РАБОТА САЙТА → 10–13&#10;КИЗ, этикетки, подтверждение печати и&#10;передача выполняются на рабочем&#10;месте.&#10;Телефон не является удалённой&#10;кнопкой «Готов»." link="data:page/id,p10">
          <mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#EDE6FF;strokeColor=#9C83CF;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
            <mxGeometry x="70" y="3800" width="460" height="240" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="20-edge-0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontColor=#233044;fontSize=18;fontFamily=Arial;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;exitPerimeter=0;entryPerimeter=0;" parent="1" edge="1" source="20-apk" target="20-login">
