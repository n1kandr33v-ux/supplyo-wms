        <mxCell id="02-edge-4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontColor=#233044;fontSize=18;fontFamily=Arial;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1.0;entryX=0.3333333333333334;entryY=0.0;exitPerimeter=0;entryPerimeter=0;" parent="1" edge="1" source="02-test" target="02-active">
