        <mxCell id="10-edge-20" value="Сбой сохранения" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontColor=#233044;fontSize=18;fontFamily=Arial;labelBackgroundColor=#FFFFFF;exitX=0.6666666666666669;exitY=1.0;entryX=0.2;entryY=0.0;exitPerimeter=0;entryPerimeter=0;" parent="1" edge="1" source="10-batchack" target="10-batcherror">
