        <mxCell id="notes-18" value="Не считать общий компонент PersonalAccount доказательством готовности live-редактора профиля: сейчас он используется для складов. Смена/восстановление пароля и подтверждение почты остаются планом. Подписка в аккаунте: название тарифа по лимиту, тестовый тип при наличии, статус, срок и занятые кабинеты. Текущий активный тариф выделен в списке, его повторная активация заблокирована. Истёкший тариф не помечается активным." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=20;fontColor=#475569;" parent="1" vertex="1">
          <mxGeometry x="70" y="1597" width="2700" height="71" as="geometry" />
        </mxCell>
        <object id="back-18" label="← К оглавлению" link="data:page/id,index">
          <mxCell style="rounded=1;html=0;fillColor=#EDE6FF;strokeColor=#9C83CF;fontSize=20;fontFamily=Arial;" parent="1" vertex="1">
            <mxGeometry x="70" y="1677" width="260" height="50" as="geometry" />
          </mxCell>
        </object>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p19" name="19 · Что происходит за экраном: данные и ограничения">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title-19" value="19 · Что происходит за экраном: данные и ограничения" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=34;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="70" y="20" width="3207" height="65" as="geometry" />
        </mxCell>
        <mxCell id="scope-19" value="Сервер / интеграции / рабочее место" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=21;fontColor=#64748B;" parent="1" vertex="1">
          <mxGeometry x="70" y="90" width="3207" height="45" as="geometry" />
        </mxCell>
        <mxCell id="status-19" value="Реализация: База, очередь, лимиты, объединение КИЗ и ежедневный локальный бэкап работают. Распределённый limiter, полный аудит и внешний бэкап — планы." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=18;fontColor=#64748B;" parent="1" vertex="1">
          <mxGeometry x="70" y="140" width="3207" height="80" as="geometry" />
        </mxCell>
        <mxCell id="19-browser" value="БРАУЗЕР&#10;Запрашивает экран / отправляет&#10;действие.&#10;API-ключи маркетплейса не получает." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="660" y="280" width="460" height="184" as="geometry" />
        </mxCell>
        <mxCell id="19-server" value="СЕРВЕР SUPPLY&#10;Сессия → права → кабинет → склад →&#10;операция.&#10;Телефон читает те же разрешённые&#10;данные, но отметки держит у себя." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1067.6666666666665" y="584" width="460" height="212" as="geometry" />
        </mxCell>
        <mxCell id="19-db" value="БАЗА ДАННЫХ&#10;Пользователи, подписки, магазины,&#10;склады, доступы, сотрудники, заказы,&#10;поставки, КИЗ, печать, учёт и файлы." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="736.6666666666666" y="2986" width="460" height="184" as="geometry" />
        </mxCell>
        <mxCell id="19-queue" value="ОЧЕРЕДЬ ЗАДАЧ&#10;Тип запроса + кабинет + нужный&#10;ресурс.&#10;Объединить одинаковые обновления,&#10;сохранить состояние задания." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="2537" y="1310" width="460" height="212" as="geometry" />
        </mxCell>
        <mxCell id="19-limits" value="РАБОТАЮЩИЕ ЛИМИТЫ WB&#10;Общий планировщик токена,&#10;интервалы и сохранённые паузы 429.&#10;КИЗ: ожидающие, пачки ≤100,&#10;объединение по кабинету; защита от&#10;старых revision." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="2537" y="1642" width="460" height="240" as="geometry" />
        </mxCell>
        <mxCell id="19-wb" value="WILDBERRIES API&#10;Новые заказы — фоновая&#10;синхронизация.&#10;Стикеры — выбранные заказы&#10;поставки.&#10;КИЗ — только ожидающие проверки." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="2537" y="2148" width="460" height="240" as="geometry" />
        </mxCell>
        <mxCell id="19-update" value="ОБНОВЛЕНИЕ ЗАКАЗОВ&#10;Фон: раз в 60 секунд без лишних&#10;уведомлений.&#10;Ручное действие пропускает обычный&#10;интервал, но не действительный 429 /&#10;Retry-After." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="2460.3333333333335" y="950" width="460" height="240" as="geometry" />
        </mxCell>
        <mxCell id="19-cache" value="ОБНОВИТЬ КЭШ / БАЗУ&#10;Сохранить подтверждённый ответ →&#10;обновить экран.&#10;При сбое показать старые данные и&#10;причину, не заменять нулями." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="660" y="2508" width="460" height="212" as="geometry" />
        </mxCell>
        <object id="19-print" label="ПЕЧАТЬ — ОТДЕЛЬНЫЙ КАНАЛ&#10;Браузер → локальный агент →&#10;принтер.&#10;Результат задания → сервер → 10–12." link="data:page/id,p10">
          <mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#EDE6FF;strokeColor=#9C83CF;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
            <mxGeometry x="914.3333333333334" y="1310" width="460" height="184" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="19-audit" value="ЖУРНАЛ И НАДЁЖНОСТЬ&#10;Кто / что / когда / какой склад.&#10;Защита от повторной оплаты, двойной&#10;поставки и старого ответа КИЗ." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#FFE9D5;strokeColor=#C99768;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1340.3333333333335" y="950" width="460" height="184" as="geometry" />
        </mxCell>
        <mxCell id="19-backup" value="ЕЖЕДНЕВНЫЙ БЭКАП НА VPS&#10;База + документы + ключ шифрования,&#10;04:15 МСК, хранение 14 дней.&#10;Копия на независимый сервер и&#10;проверка восстановления ещё не&#10;завершены." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="736.6666666666666" y="3290" width="460" height="240" as="geometry" />
        </mxCell>
        <mxCell id="19-secrets" value="СЕКРЕТЫ И ДОСТУП&#10;Ключи WB зашифрованы и не&#10;возвращаются frontend. Пароли scrypt,&#10;сессии HttpOnly/Secure.&#10;Авторизация и складские права&#10;действуют на каждом запросе;&#10;вложения изолированы." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="70" y="280" width="460" height="268" as="geometry" />
        </mxCell>
        <mxCell id="19-publish" value="ПУБЛИКАЦИЯ И ОТКАТ&#10;Проверки → сборка → бэкап → новый&#10;каталог → SHA-256 → атомарное&#10;переключение.&#10;Health и публичные файлы&#10;проверяются после активации." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#F5F6F8;strokeColor=#A5AFBE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1900.3333333333335" y="950" width="460" height="240" as="geometry" />
        </mxCell>
        <mxCell id="19-edge-0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontColor=#233044;fontSize=18;fontFamily=Arial;labelBackgroundColor=#FFFFFF;exitX=0.6666666666666669;exitY=1.0;entryX=0.5;entryY=0.0;exitPerimeter=0;entryPerimeter=0;" parent="1" edge="1" source="19-browser" target="19-server">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="966.6666666666667" y="502" />
              <mxPoint x="1297.6666666666665" y="502" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="19-edge-1" value="Чтение" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontColor=#233044;fontSize=18;fontFamily=Arial;labelBackgroundColor=#FFFFFF;exitX=0.8333333333333337;exitY=1.0;entryX=0.6666666666666666;entryY=0.0;exitPerimeter=0;entryPerimeter=0;" parent="1" edge="1" source="19-server" target="19-db">
