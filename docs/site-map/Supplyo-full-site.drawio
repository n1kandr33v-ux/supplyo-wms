  <diagram id="p05" name="05 · Клиент выдаёт доступ / ФФ подключает клиента">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title-05" value="05 · Клиент выдаёт доступ / ФФ подключает клиента" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=34;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="70" y="20" width="1657" height="65" as="geometry" />
        </mxCell>
        <mxCell id="scope-05" value="Клиент → сервер → владелец ФФ" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=21;fontColor=#64748B;" parent="1" vertex="1">
          <mxGeometry x="70" y="90" width="1657" height="45" as="geometry" />
        </mxCell>
        <mxCell id="status-05" value="Реализация: Одноразовые коды и серверные ограничения есть." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=18;fontColor=#64748B;" parent="1" vertex="1">
          <mxGeometry x="70" y="140" width="1657" height="80" as="geometry" />
        </mxCell>
        <mxCell id="05-client" value="КЛИЕНТ&#10;Свой магазин уже подключён → 04.&#10;Настройки → Доступ фулфилменту." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="553.3333333333333" y="280" width="460" height="156" as="geometry" />
        </mxCell>
        <mxCell id="05-select" value="Выбрать кабинет и ОДИН склад WB&#10;Если магазинов несколько, выбрать&#10;нужный.&#10;Без выбора маркетплейса повторно." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="553.3333333333333" y="556" width="460" height="184" as="geometry" />
        </mxCell>
        <mxCell id="05-code" value="Создать одноразовый код&#10;Связан с владельцем, кабинетом и&#10;складом.&#10;Срок 24 часа.&#10;В базе только хеш кода." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="553.3333333333333" y="860" width="460" height="212" as="geometry" />
        </mxCell>
        <mxCell id="05-share" value="Скопировать код и передать ФФ&#10;Пользователь передаёт код сам.&#10;Сайт не отправляет&#10;письмо-приглашение." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="630" y="1206" width="460" height="184" as="geometry" />
        </mxCell>
        <mxCell id="05-ff" value="ВЛАДЕЛЕЦ ФФ&#10;Активная подписка → 02.&#10;Настройки → Клиенты." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1190" y="1248" width="460" height="156" as="geometry" />
        </mxCell>
        <mxCell id="05-input" value="«Добавить клиента»&#10;Ввести только одноразовый код.&#10;Email и выбор маркетплейса не нужны." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1190" y="1524" width="460" height="156" as="geometry" />
        </mxCell>
        <mxCell id="05-check" value="Проверка сервера&#10;Код существует, не истёк&#10;и не использован?&#10;Не свой кабинет? Нет&#10;дубля?&#10;Лимит подписки&#10;позволяет?" style="rhombus;whiteSpace=wrap;html=0;fillColor=#FFF0C9;strokeColor=#C99726;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1113.3333333333333" y="1800" width="460" height="464" as="geometry" />
        </mxCell>
        <mxCell id="05-bad" value="Код неверный / истёк / уже&#10;использован&#10;Понятная причина.&#10;Кабинет не подключается в статусе&#10;«ожидает» навсегда." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#FFE3DE;strokeColor=#D37D6A;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="630" y="2530" width="460" height="212" as="geometry" />
        </mxCell>
        <mxCell id="05-grant" value="Атомарно погасить код&#10;Создать принятый доступ ФФ.&#10;Доступ только к выбранному складу.&#10;API-ключ клиенту ФФ не раскрывается." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#DFF4E4;strokeColor=#65A773;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1190" y="2544" width="460" height="184" as="geometry" />
        </mxCell>
        <object id="05-bind" label="06 Связать с физическим складом ФФ&#10;Кабинет клиента + warehouseId WB&#10;→ конкретный склад, созданный ФФ." link="data:page/id,p06">
          <mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#EDE6FF;strokeColor=#9C83CF;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
            <mxGeometry x="1190" y="2862" width="460" height="156" as="geometry" />
          </mxCell>
        </object>
        <object id="05-work" label="ФФ: 08 Обзор → 09 Заказы&#10;Только переданный склад.&#10;Сотрудники видят его лишь через&#10;назначение → 07." link="data:page/id,p08">
          <mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#EDE6FF;strokeColor=#9C83CF;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
            <mxGeometry x="706.6666666666666" y="3152" width="460" height="184" as="geometry" />
          </mxCell>
        </object>
        <object id="05-owner" label="Клиент: 08 Обзор&#10;Его кабинет и склад WB.&#10;Название физического склада ФФ.&#10;Без собственной подписки обзор&#10;доступен." link="data:page/id,p08">
          <mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#EDE6FF;strokeColor=#9C83CF;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
            <mxGeometry x="1266.6666666666665" y="3138" width="460" height="212" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="05-revoke" value="ОТОЗВАТЬ ДОСТУП&#10;Клиент может отозвать в любой&#10;момент.&#10;ФФ и его сотрудники теряют&#10;разрешение.&#10;Данные владельца остаются." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1266.6666666666665" y="3470" width="460" height="240" as="geometry" />
        </mxCell>
        <mxCell id="05-newcode" value="НОВЫЙ КОД&#10;Старый неиспользованный код&#10;отменяется.&#10;Уже принятый доступ живёт до&#10;отдельного отзыва." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="70" y="1192" width="460" height="212" as="geometry" />
        </mxCell>
        <mxCell id="05-disconnect" value="ОТКЛЮЧЕНИЕ ФФ&#10;ФФ отключил клиента или его подписка&#10;истекла → рабочий доступ закрыт.&#10;Не удалять собственный магазин&#10;клиента." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="706.6666666666666" y="3470" width="460" height="212" as="geometry" />
        </mxCell>
        <mxCell id="05-edge-0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontColor=#233044;fontSize=18;fontFamily=Arial;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;exitPerimeter=0;entryPerimeter=0;" parent="1" edge="1" source="05-client" target="05-select">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="05-edge-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontColor=#233044;fontSize=18;fontFamily=Arial;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;exitPerimeter=0;entryPerimeter=0;" parent="1" edge="1" source="05-select" target="05-code">
