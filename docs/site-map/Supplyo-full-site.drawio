  <diagram id="p06" name="06 · Физические склады и привязка к WB">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title-06" value="06 · Физические склады и привязка к WB" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=34;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="70" y="20" width="1580" height="65" as="geometry" />
        </mxCell>
        <mxCell id="scope-06" value="Владелец ФФ / сотрудник с правом управления" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=21;fontColor=#64748B;" parent="1" vertex="1">
          <mxGeometry x="70" y="90" width="1580" height="45" as="geometry" />
        </mxCell>
        <mxCell id="status-06" value="Реализация: Склады и серверные привязки есть. Не путать два вида склада." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=18;fontColor=#64748B;" parent="1" vertex="1">
          <mxGeometry x="70" y="140" width="1580" height="80" as="geometry" />
        </mxCell>
        <mxCell id="06-physical" value="ФИЗИЧЕСКИЙ СКЛАД ФФ&#10;Название, город, адрес.&#10;Например «ОптимумПак · Казань».&#10;Создаётся в supply." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1151.6666666666667" y="280" width="460" height="184" as="geometry" />
        </mxCell>
        <mxCell id="06-wb" value="СКЛАД ПРОДАВЦА WB&#10;warehouseId + название.&#10;Приходит из API магазина.&#10;Клиент выдаёт доступ к нему через 05." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="591.6666666666667" y="280" width="460" height="184" as="geometry" />
        </mxCell>
        <mxCell id="06-create" value="Аккаунт → Склады → Добавить склад&#10;Название · город · адрес.&#10;Сотрудники добавляются отдельно →&#10;07." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1151.6666666666667" y="1112" width="460" height="184" as="geometry" />
        </mxCell>
        <mxCell id="06-binding" value="ПРИВЯЗКА&#10;Кабинет + склад WB + принятый&#10;доступ&#10;→ один физический склад ФФ.&#10;Один физический склад может&#10;обслуживать несколько клиентов." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1075" y="1416" width="460" height="240" as="geometry" />
        </mxCell>
        <mxCell id="06-explicit" value="Несколько физических&#10;складов?&#10;Нельзя выбирать&#10;случайный.&#10;Администратор явно&#10;указывает привязку." style="rhombus;whiteSpace=wrap;html=0;fillColor=#FFF0C9;strokeColor=#C99726;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="591.6666666666667" y="584" width="460" height="408" as="geometry" />
        </mxCell>
        <mxCell id="06-card" value="Карточка склада&#10;Название · город · адрес&#10;Карандаш только для адреса&#10;Сотрудники с доступом&#10;Удаление через подтверждение" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="630" y="1776" width="460" height="212" as="geometry" />
        </mxCell>
        <object id="06-staff" label="07 Назначить сотрудников&#10;Права распространяются на&#10;WB-привязки этого физического&#10;склада.&#10;Не на все кабинеты организации." link="data:page/id,p07">
          <mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#EDE6FF;strokeColor=#9C83CF;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
            <mxGeometry x="70" y="1776" width="460" height="212" as="geometry" />
          </mxCell>
        </object>
        <object id="06-overview" label="08 Обзор&#10;ФФ: все доступные собственные и&#10;клиентские складские контексты.&#10;Клиент: только его склады у ФФ." link="data:page/id,p08">
          <mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#EDE6FF;strokeColor=#9C83CF;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
            <mxGeometry x="1190" y="1776" width="460" height="184" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="06-edit" value="Редактировать адрес&#10;Отдельное поле / окно.&#10;Изменение адреса не меняет&#10;warehouseId WB." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="146.66666666666674" y="2108" width="460" height="184" as="geometry" />
        </mxCell>
        <mxCell id="06-delete" value="Удалить склад?&#10;Проверить связанные&#10;документы и&#10;сотрудников.&#10;Если есть записи учёта,&#10;сначала разрешить&#10;связи." style="rhombus;whiteSpace=wrap;html=0;fillColor=#FFF0C9;strokeColor=#C99726;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="706.6666666666667" y="2108" width="460" height="464" as="geometry" />
        </mxCell>
        <mxCell id="06-blocked" value="Удаление заблокировано&#10;Не оставлять учёт и доступы без&#10;склада.&#10;Показать связанные данные." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#FFE3DE;strokeColor=#D37D6A;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="223.33333333333337" y="2838" width="460" height="184" as="geometry" />
        </mxCell>
        <mxCell id="06-remove" value="Подтвердить удаление&#10;Убирается физический склад и его&#10;назначения.&#10;Сам магазин WB клиента не&#10;удаляется." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#DFF4E4;strokeColor=#65A773;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="783.3333333333334" y="2838" width="460" height="212" as="geometry" />
        </mxCell>
        <mxCell id="06-edge-0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontColor=#233044;fontSize=18;fontFamily=Arial;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;exitPerimeter=0;entryPerimeter=0;" parent="1" edge="1" source="06-physical" target="06-create">
