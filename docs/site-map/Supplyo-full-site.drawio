  <diagram id="p18" name="18 · Профиль, организация, подписка и выход">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title-18" value="18 · Профиль, организация, подписка и выход" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=34;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="70" y="20" width="2700" height="65" as="geometry" />
        </mxCell>
        <mxCell id="scope-18" value="Каждый зарегистрированный пользователь" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=21;fontColor=#64748B;" parent="1" vertex="1">
          <mxGeometry x="70" y="90" width="2700" height="45" as="geometry" />
        </mxCell>
        <mxCell id="status-18" value="Реализация: В live-профиле есть просмотр ФИО/email, доступов и подписки. Полный редактор профиля/организации и безопасность ещё не перенесены из макета." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=18;fontColor=#64748B;" parent="1" vertex="1">
          <mxGeometry x="70" y="140" width="2700" height="80" as="geometry" />
        </mxCell>
        <mxCell id="18-menu" value="МЕНЮ АККАУНТА ВНИЗУ СЛЕВА&#10;Открывается справа от панели.&#10;Профиль / склады / учёт / выйти — по&#10;доступу." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="2080" y="280" width="460" height="184" as="geometry" />
        </mxCell>
        <mxCell id="18-profile" value="LIVE-ПРОФИЛЬ&#10;Просмотр ФИО, email, доступов&#10;сотрудника и статуса подписки.&#10;Переход к тарифу / подписке." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="2156.6666666666665" y="584" width="460" height="184" as="geometry" />
        </mxCell>
        <mxCell id="18-edit" value="ПОЛНЫЙ РЕДАКТОР ПРОФИЛЯ —&#10;ПЛАН&#10;Поля телефона, Telegram, организации&#10;и безопасное изменение личных&#10;данных есть в макете.&#10;В рабочем экране пока только&#10;просмотр." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#FFE9D5;strokeColor=#C99768;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1750" y="922" width="460" height="268" as="geometry" />
        </mxCell>
        <mxCell id="18-org" value="ОРГАНИЗАЦИЯ — ПЛАН&#10;Название фулфилмента и ИНН.&#10;Полная форма макета не означает&#10;готовый live-редактор." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#FFE9D5;strokeColor=#C99768;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="630" y="922" width="460" height="184" as="geometry" />
        </mxCell>
        <object id="18-sub" label="МОЯ ПОДПИСКА&#10;Тариф, статус, срок действия,&#10;кабинетов X из N.&#10;Без лимита сотрудников.&#10;Продлить / выбрать → 02." link="data:page/id,p02">
          <mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#EDE6FF;strokeColor=#9C83CF;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
            <mxGeometry x="70" y="922" width="460" height="212" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="18-security" value="БЕЗОПАСНОСТЬ&#10;Смена пароля: текущий → новый →&#10;подтверждение.&#10;Восстановление через проверенную&#10;почту — отдельный сценарий." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#FFE9D5;strokeColor=#C99768;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="2310" y="922" width="460" height="212" as="geometry" />
        </mxCell>
        <mxCell id="18-save" value="СОХРАНИТЬ НА СЕРВЕРЕ&#10;Проверка значений и владельца&#10;профиля.&#10;Email влияет на привязку сотрудника:&#10;нужна безопасная процедура смены." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#FFE9D5;strokeColor=#C99768;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1750" y="1310" width="460" height="212" as="geometry" />
        </mxCell>
        <mxCell id="18-timezone" value="ЧАСОВОЙ ПОЯС&#10;Удобный список с читаемым&#10;выбранным значением.&#10;Единое применение ко времени сайта&#10;нужно довести." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#FFE9D5;strokeColor=#C99768;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1190" y="922" width="460" height="212" as="geometry" />
        </mxCell>
        <mxCell id="18-logout" value="ВЫЙТИ&#10;Завершить серверную сессию → 01&#10;Вход.&#10;Данные и подписка не удаляются." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#DFF4E4;strokeColor=#65A773;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1596.6666666666667" y="584" width="460" height="184" as="geometry" />
        </mxCell>
        <mxCell id="18-edge-0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontColor=#233044;fontSize=18;fontFamily=Arial;labelBackgroundColor=#FFFFFF;exitX=0.6666666666666663;exitY=1.0;entryX=0.5;entryY=0.0;exitPerimeter=0;entryPerimeter=0;" parent="1" edge="1" source="18-menu" target="18-profile">
