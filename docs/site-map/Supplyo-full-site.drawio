          <mxCell style="rounded=1;html=0;fillColor=#EDE6FF;strokeColor=#9C83CF;fontSize=20;fontFamily=Arial;" parent="1" vertex="1">
            <mxGeometry x="70" y="2471" width="260" height="50" as="geometry" />
          </mxCell>
        </object>
