              <mxPoint x="1801" y="2526" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="10-edge-7" value="Да" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontColor=#233044;fontSize=18;fontFamily=Arial;labelBackgroundColor=#FFFFFF;exitX=0.33333333333333315;exitY=0.833333333333334;entryX=0.5;entryY=0.0;exitPerimeter=0;entryPerimeter=0;" parent="1" edge="1" source="10-required" target="10-kiz">
