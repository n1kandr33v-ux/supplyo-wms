          </mxGeometry>
        </mxCell>
        <mxCell id="10-edge-3" value="Новый скан" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontColor=#233044;fontSize=18;fontFamily=Arial;labelBackgroundColor=#FFFFFF;exitX=0.33333333333333315;exitY=0.0;entryX=0.2500000000000005;entryY=1.0;exitPerimeter=0;entryPerimeter=0;" parent="1" edge="1" source="10-notfound" target="10-scan">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1647.666666666667" y="1002" />
              <mxPoint x="2092.666666666667" y="1002" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="10-edge-4" value="Да" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontColor=#233044;fontSize=18;fontFamily=Arial;labelBackgroundColor=#FFFFFF;exitX=0.6666666666666669;exitY=0.8333333333333336;entryX=0.5;entryY=0.0;exitPerimeter=0;entryPerimeter=0;" parent="1" edge="1" source="10-match" target="10-meta">
