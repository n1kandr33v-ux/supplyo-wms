              <mxPoint x="1671.6666666666667" y="502" />
              <mxPoint x="1786.3333333333335" y="502" />
              <mxPoint x="1786.3333333333335" y="834" />
              <mxPoint x="1671.6666666666667" y="834" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="13-edge-2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontColor=#233044;fontSize=18;fontFamily=Arial;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1.0;entryX=0.33333333333333315;entryY=0.0;exitPerimeter=0;entryPerimeter=0;" parent="1" edge="1" source="13-install" target="13-discover">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="13-edge-3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontColor=#233044;fontSize=18;fontFamily=Arial;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;exitPerimeter=0;entryPerimeter=0;" parent="1" edge="1" source="13-discover" target="13-select">
