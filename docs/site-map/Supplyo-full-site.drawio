  <diagram id="p04" name="04 · Подключённые магазины и API">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title-04" value="04 · Подключённые магазины и API" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=34;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="70" y="20" width="2370" height="65" as="geometry" />
        </mxCell>
        <mxCell id="scope-04" value="Владелец магазина, с подпиской или без неё" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=21;fontColor=#64748B;" parent="1" vertex="1">
          <mxGeometry x="70" y="90" width="2370" height="45" as="geometry" />
        </mxCell>
        <mxCell id="status-04" value="Реализация: WB: подключение, замена ключа и удаление магазина реализованы. Ozon — план." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=18;fontColor=#64748B;" parent="1" vertex="1">
          <mxGeometry x="70" y="140" width="2370" height="80" as="geometry" />
        </mxCell>
        <mxCell id="04-stores" value="Настройки → Магазины&#10;Список своих подключённых&#10;кабинетов.&#10;Название автоматически из&#10;маркетплейса." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1573.6666666666667" y="280" width="460" height="212" as="geometry" />
        </mxCell>
        <mxCell id="04-wb" value="Подключить Wildberries&#10;Ввести персональный API-ключ с&#10;нужными правами.&#10;Не вводить название магазина&#10;вручную." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="657.3333333333334" y="612" width="460" height="212" as="geometry" />
        </mxCell>
        <mxCell id="04-ozon" value="Подключить Ozon&#10;Client ID + API-ключ.&#10;Оба поля можно редактировать&#10;карандашом." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#FFE9D5;strokeColor=#C99768;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1688.6666666666667" y="626" width="460" height="184" as="geometry" />
        </mxCell>
        <mxCell id="04-verify" value="СЕРВЕР ПРОВЕРЯЕТ WB-КЛЮЧ&#10;Название берётся из WB. Ключ&#10;шифруется AES-GCM и не&#10;возвращается браузеру.&#10;Подключить свой магазин можно без&#10;подписки." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1612" y="944" width="460" height="240" as="geometry" />
        </mxCell>
        <mxCell id="04-error" value="Ключ отклонён / истёк / нет прав&#10;Показать причину.&#10;Можно исправить реквизиты.&#10;Не объявлять магазин подключённым." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#FFE3DE;strokeColor=#D37D6A;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="630" y="1672" width="460" height="184" as="geometry" />
        </mxCell>
        <mxCell id="04-ok" value="КАБИНЕТ ПОДКЛЮЧЁН&#10;Название WB, статус и время&#10;обновления.&#10;Открыть заказы / выдать доступ /&#10;заменить ключ / удалить магазин." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#DFF4E4;strokeColor=#65A773;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1750" y="1690.6666666666667" width="460" height="212" as="geometry" />
        </mxCell>
        <mxCell id="04-retry" value="WB временно недоступен / 429&#10;Очередь и повтор по лимитам.&#10;Старые данные не исчезают.&#10;19 Синхронизация." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#FFF0C9;strokeColor=#C99726;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1190" y="1672" width="460" height="184" as="geometry" />
        </mxCell>
        <mxCell id="04-scope" value="Есть право загружать&#10;рабочие данные?&#10;Своя подписка ИЛИ&#10;активный ФФ с&#10;выданным доступом." style="rhombus;whiteSpace=wrap;html=0;fillColor=#FFF0C9;strokeColor=#C99726;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1074.3333333333335" y="2032" width="460" height="352" as="geometry" />
        </mxCell>
        <object id="04-only" label="Без рабочего доступа&#10;Магазин хранится и может быть&#10;передан ФФ через код → 05.&#10;Подключение API не включает&#10;подписку." link="data:page/id,p05">
          <mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#EDE6FF;strokeColor=#9C83CF;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
            <mxGeometry x="778.0000000000001" y="3088" width="460" height="212" as="geometry" />
          </mxCell>
        </object>
        <object id="04-sync" label="Есть рабочий доступ&#10;Фоновая загрузка нужных заказов и&#10;складов → 19.&#10;Выбор кабинета / города ограничивает&#10;рабочий контекст." link="data:page/id,p19">
          <mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#EDE6FF;strokeColor=#9C83CF;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
            <mxGeometry x="1903.3333333333335" y="3752" width="460" height="212" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="04-edit" value="ЗАМЕНИТЬ API-КЛЮЧ&#10;Только владелец магазина. Ввести&#10;новый ключ в отдельном окне.&#10;История, ID кабинета, остатки и&#10;выданные доступы сохраняются." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1826.6666666666667" y="2125.333333333333" width="460" height="212" as="geometry" />
        </mxCell>
        <mxCell id="04-keycheck" value="КЛЮЧ ТОГО ЖЕ&#10;ПРОДАВЦА?&#10;Проверить seller-info и&#10;доступ к чтению FBS.&#10;Чужой продавец,&#10;неверные права,&#10;занятый ключ или 429?" style="rhombus;whiteSpace=wrap;html=0;fillColor=#FFF0C9;strokeColor=#C99726;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1903.3333333333335" y="2504" width="460" height="464" as="geometry" />
        </mxCell>
        <mxCell id="04-keyreject" value="ЗАМЕНА ОТКЛОНЕНА&#10;Старый ключ остаётся действующим.&#10;Показать причину.&#10;Активная синхронизация / изменение&#10;подключения: дождаться и повторить." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#FFE3DE;strokeColor=#D37D6A;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1420" y="3420" width="460" height="212" as="geometry" />
        </mxCell>
        <mxCell id="04-keysave" value="ЗАМЕНА ПОДТВЕРЖДЕНА&#10;Зашифровать новый ключ; заменить&#10;без удаления магазина.&#10;Старые ожидающие задачи отменить,&#10;поставить новую проверку в очередь." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#DFF4E4;strokeColor=#65A773;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1980" y="3420" width="460" height="212" as="geometry" />
        </mxCell>
        <mxCell id="04-remove" value="УДАЛИТЬ МАГАЗИН&#10;Только владелец, отдельное&#10;подтверждение с названием.&#10;Отмена ничего не меняет." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="70" y="626" width="460" height="184" as="geometry" />
        </mxCell>
        <mxCell id="04-removed" value="МАГАЗИН СКРЫТ, ДОСТУПЫ&#10;ОТОЗВАНЫ&#10;Очистить ключ, отменить задачи и&#10;убрать складские привязки.&#10;История и остатки сохраняются;&#10;синхронизация не воскресит магазин." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#DFF4E4;strokeColor=#65A773;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="70" y="1312" width="460" height="240" as="geometry" />
        </mxCell>
        <mxCell id="04-reconnect" value="ПОВТОРНОЕ ПОДКЛЮЧЕНИЕ&#10;Тот же ключ в том же аккаунте&#10;восстанавливает кабинет и историю.&#10;Отозванные доступы и привязки сами&#10;не возвращаются. Другому аккаунту&#10;историю не передавать." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#F5F6F8;strokeColor=#A5AFBE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="70" y="1672" width="460" height="240" as="geometry" />
        </mxCell>
        <mxCell id="04-edge-0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontColor=#233044;fontSize=18;fontFamily=Arial;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;exitPerimeter=0;entryPerimeter=0;" parent="1" edge="1" source="04-stores" target="04-wb">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1803.6666666666667" y="556" />
              <mxPoint x="887.3333333333334" y="556" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="04-edge-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontColor=#233044;fontSize=18;fontFamily=Arial;labelBackgroundColor=#FFFFFF;exitX=0.75;exitY=1.0;entryX=0.5;entryY=0.0;exitPerimeter=0;entryPerimeter=0;" parent="1" edge="1" source="04-stores" target="04-ozon">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="04-edge-2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontColor=#233044;fontSize=18;fontFamily=Arial;labelBackgroundColor=#FFFFFF;exitX=0.6666666666666666;exitY=1.0;entryX=0.33333333333333315;entryY=0.0;exitPerimeter=0;entryPerimeter=0;" parent="1" edge="1" source="04-wb" target="04-verify">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
