            <mxGeometry x="70" y="2879" width="260" height="50" as="geometry" />
          </mxCell>
        </object>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p10" name="10 · Сборка: сканирование, режим «Авто» и заказы без КИЗ">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title-10" value="10 · Сборка: сканирование, режим «Авто» и заказы без КИЗ" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=34;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="70" y="20" width="4471" height="65" as="geometry" />
        </mxCell>
        <mxCell id="scope-10" value="Сборщик / владелец" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=21;fontColor=#64748B;" parent="1" vertex="1">
          <mxGeometry x="70" y="90" width="4471" height="45" as="geometry" />
        </mxCell>
        <mxCell id="status-10" value="Реализация: «Авто»: подготовка всего пакета, одно задание агента, атомарное подтверждение. КИЗ — отдельный поток." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=18;fontColor=#64748B;" parent="1" vertex="1">
          <mxGeometry x="70" y="140" width="4471" height="80" as="geometry" />
        </mxCell>
        <mxCell id="10-supply" value="ОТКРЫТЬ ПОСТАВКУ&#10;Только доступный кабинет и склад.&#10;Все заказы поставки и «Собрано X из&#10;Y»." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="3398.3333333333335" y="364" width="460" height="184" as="geometry" />
        </mxCell>
        <mxCell id="10-scan" value="СКАНИРОВАНИЕ ТОВАРА&#10;Отдельное поле баркода. Русская&#10;раскладка преобразуется в английскую&#10;по физическим клавишам; вставка&#10;кода тоже поддерживается.&#10;Сканер завершает ввод Enter. При&#10;ручном вводе — Enter. Поиск и&#10;обычный текст не преобразуются." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1977.6666666666667" y="668" width="460" height="296" as="geometry" />
        </mxCell>
        <mxCell id="10-focus" value="ВВОД БЕЗ ЛИШНЕГО КЛИКА&#10;Фокус возвращается после входа в&#10;сборку, печати, ошибки и закрытия&#10;КИЗ.&#10;Другие поля и открытые меню не&#10;перехватываются. Пустой поиск&#10;возвращает фокус через 4 с." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1901" y="280" width="460" height="268" as="geometry" />
        </mxCell>
        <mxCell id="10-match" value="БАРКОД ЕСТЬ СРЕДИ&#10;ЗАКАЗОВ БЕЗ&#10;ПОДТВЕРЖДЁННОЙ&#10;ПЕЧАТИ?" style="rhombus;whiteSpace=wrap;html=0;fillColor=#FFF0C9;strokeColor=#C99726;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1977.6666666666667" y="1472" width="460" height="296" as="geometry" />
        </mxCell>
        <mxCell id="10-notfound" value="НЕ НАЙДЕН СЛЕДУЮЩИЙ&#10;ЭКЗЕМПЛЯР&#10;Нет баркода в этой поставке —&#10;показать ошибку.&#10;Если всё уже напечатано —&#10;предложить явную перепечатку нужной&#10;строки." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#FFE3DE;strokeColor=#D37D6A;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1494.3333333333335" y="2220" width="460" height="268" as="geometry" />
        </mxCell>
        <mxCell id="10-meta" value="WB ОПРЕДЕЛЯЕТ МАРКИРОВКУ&#10;Проверяем requiredMeta И optionalMeta&#10;конкретного заказа.&#10;sgtin в любом из двух списков → нужен&#10;КИЗ. Ручной галочки нет." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="2054.333333333333" y="2257.333333333333" width="460" height="212" as="geometry" />
        </mxCell>
        <mxCell id="10-unknown" value="ТРЕБОВАНИЯ НЕИЗВЕСТНЫ&#10;Обновить данные заказа.&#10;Не считать отсутствие данных&#10;разрешением печатать без КИЗ — ни&#10;вручную, ни в «Авто»." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#FFF0C9;strokeColor=#C99726;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="2131" y="2754" width="460" height="212" as="geometry" />
        </mxCell>
        <mxCell id="10-required" value="Есть sgtin в requiredMeta&#10;или optionalMeta?" style="rhombus;whiteSpace=wrap;html=0;fillColor=#FFF0C9;strokeColor=#C99726;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1571" y="2754" width="460" height="220" as="geometry" />
        </mxCell>
        <object id="10-kiz" label="НУЖЕН КИЗ&#10;Сканирование и проверка → 11." link="data:page/id,p11">
          <mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#EDE6FF;strokeColor=#9C83CF;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
            <mxGeometry x="1087.6666666666665" y="3240" width="460" height="130" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="10-label" value="ОДИН ЗАКАЗ БЕЗ КИЗ&#10;Получить или взять из кэша стикер&#10;одного заказа.&#10;Отправить агенту → раздел 13." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="660" y="4184" width="460" height="184" as="geometry" />
        </mxCell>
        <mxCell id="10-ready" value="ГОТОВ БЕЗ КИЗ&#10;После подтверждения агента и&#10;сохранения результата.&#10;Для пакета все заказы обновляются&#10;одной транзакцией. Физический выход&#10;бумаги ответ агента не доказывает." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#DFF4E4;strokeColor=#65A773;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="736.6666666666665" y="6140" width="460" height="240" as="geometry" />
        </mxCell>
        <mxCell id="10-statuses" value="СТАТУСЫ В ТАБЛИЦЕ&#10;Ожидает — жёлтый&#10;Проверяется — синий&#10;Готов — зелёный&#10;Ошибка / Ошибка КИЗ — красный." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#F5F6F8;strokeColor=#A5AFBE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="70" y="280" width="460" height="212" as="geometry" />
        </mxCell>
        <mxCell id="10-auto" value="Переключатель «Авто»&#10;включён?" style="rhombus;whiteSpace=wrap;html=0;fillColor=#FFF0C9;strokeColor=#C99726;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1647.6666666666665" y="3240" width="460" height="220" as="geometry" />
        </mxCell>
        <mxCell id="10-batch" value="ВСЕ СТИКЕРЫ ЭТОГО ТОВАРА&#10;Текущий кабинет и выбранная&#10;поставка. Совпадает отсканированный&#10;баркод.&#10;Только «Ожидает», не напечатаны,&#10;requiredMeta явно пуст; в optionalMeta&#10;нет sgtin.&#10;Готовые и заказы с КИЗ исключены." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1724.3333333333335" y="3726" width="460" height="296" as="geometry" />
        </mxCell>
        <mxCell id="10-batchlabels" value="ПОДГОТОВИТЬ ВЕСЬ ПАКЕТ&#10;WB: до 100 заказов за запрос.&#10;Проверить наличие каждого стикера и&#10;сопоставить по ID заказа.&#10;Сохранить состав и единый ID задания&#10;на сервере. Ничего не печатать до&#10;полной готовности. До 1000 этикеток." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1724.3333333333335" y="4142" width="460" height="268" as="geometry" />
        </mxCell>
        <mxCell id="10-batchprint" value="ОДНО ЗАДАНИЕ АГЕНТУ&#10;Передать сразу все стикеры. Агент&#10;сначала загружает все изображения,&#10;затем одним заданием отправляет их в&#10;очередь Windows.&#10;Без отдельных запросов на каждый&#10;стикер. Повторный скан во время&#10;операции заблокирован." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1235" y="4676" width="460" height="296" as="geometry" />
        </mxCell>
        <mxCell id="10-batchok" value="Агент подтвердил&#10;передачу всего пакета в&#10;очередь Windows?" style="rhombus;whiteSpace=wrap;html=0;fillColor=#FFF0C9;strokeColor=#C99726;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1235" y="5092" width="460" height="240" as="geometry" />
        </mxCell>
        <mxCell id="10-batcherror" value="ПАКЕТ НЕ ПОДТВЕРЖДЁН&#10;Ошибка WB: ничего не печатать.&#10;Ошибка агента: не менять готовность.&#10;Повтор — тот же сохранённый пакет и&#10;ID. Завершённое задание агент&#10;повторно не печатает. Если результат&#10;неопределён — проверить принтер,&#10;автоматический дубль заблокирован." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#FFE3DE;strokeColor=#D37D6A;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="2261" y="6140" width="460" height="296" as="geometry" />
        </mxCell>
        <mxCell id="10-batchack" value="СОХРАНИТЬ РЕЗУЛЬТАТ ПАКЕТА&#10;Один запрос по ID пакета → одной&#10;транзакцией отметить все его заказы&#10;готовыми.&#10;Повтор подтверждения безопасен. При&#10;сбое сохранения повторить тот же&#10;пакет; агент не создаст дубль печати." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="930.6666666666665" y="5598" width="460" height="268" as="geometry" />
        </mxCell>
        <mxCell id="10-next" value="СЛЕДУЮЩИЙ ОДИНАКОВЫЙ ТОВАР&#10;printed=true исключается даже при&#10;«Проверяется» или «Ошибка КИЗ».&#10;Без подтверждения печати&#10;повторяется прежнее задание. Не&#10;выбирать первую строку только по&#10;статусу." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1977.6666666666667" y="1084" width="460" height="268" as="geometry" />
        </mxCell>
        <mxCell id="10-columns" value="ТАБЛИЦА СБОРКИ&#10;Статус → номер заказа → товар →&#10;адрес → код → баркоды → стикер WB&#10;текстом → действия.&#10;Статус и номер компактные. «Ячейка»&#10;в интерфейсе переименована в «Код»." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#F5F6F8;strokeColor=#A5AFBE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="3444.3333333333335" y="705.3333333333333" width="460" height="240" as="geometry" />
        </mxCell>
        <mxCell id="10-sort" value="ПОРЯДОК И ПОИСК&#10;Натуральная сортировка по адресу,&#10;затем баркоду и номеру заказа.&#10;Одинаковые товары рядом.&#10;Поиск включает код, адрес и номер&#10;стикера." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#F5F6F8;strokeColor=#A5AFBE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="2961" y="1084" width="460" height="240" as="geometry" />
        </mxCell>
        <mxCell id="10-stickertext" value="ТЕКСТОВЫЙ СТИКЕР WB&#10;partA + partB, ведущие нули&#10;сохранены; запасной вариант —&#10;barcode.&#10;Загрузить недостающие номера&#10;пачками до 100, кэшировать по заказу.&#10;Печать этим не подтверждается." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#F5F6F8;strokeColor=#A5AFBE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="3521" y="1084" width="460" height="268" as="geometry" />
        </mxCell>
        <mxCell id="10-transfer" value="ПЕРЕНОС ЗАКАЗОВ&#10;Выбрать до 100 заказов галочками →&#10;существующая открытая поставка того&#10;же склада или новая. Нужно право на&#10;поставки." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="4081" y="1112" width="460" height="212" as="geometry" />
        </mxCell>
        <mxCell id="10-transferdest" value="ПОДТВЕРДИТЬ ПЕРЕНОС В WB&#10;Сохранить КИЗ, печать и заметки.&#10;Повтор использует ту же цель;&#10;незавершённую пакетную печать&#10;сначала завершить." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="4004.3333333333335" y="1888" width="460" height="212" as="geometry" />
        </mxCell>
        <mxCell id="10-edge-0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontColor=#233044;fontSize=18;fontFamily=Arial;labelBackgroundColor=#FFFFFF;exitX=0.2;exitY=1.0;entryX=0.6666666666666669;entryY=0.0;exitPerimeter=0;entryPerimeter=0;" parent="1" edge="1" source="10-supply" target="10-scan">
          <mxGeometry relative="1" as="geometry">
