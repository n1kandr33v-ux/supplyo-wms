            <Array as="points">
              <mxPoint x="1724.3333333333335" y="3012" />
              <mxPoint x="1317.6666666666665" y="3012" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="10-edge-8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontColor=#233044;fontSize=18;fontFamily=Arial;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1.0;entryX=0.3333333333333334;entryY=0.0;exitPerimeter=0;entryPerimeter=0;" parent="1" edge="1" source="10-label" target="10-ready">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="10-edge-9" value="Нет" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontColor=#233044;fontSize=18;fontFamily=Arial;labelBackgroundColor=#FFFFFF;exitX=0.6666666666666669;exitY=0.833333333333334;entryX=0.5;entryY=0.0;exitPerimeter=0;entryPerimeter=0;" parent="1" edge="1" source="10-required" target="10-auto">
