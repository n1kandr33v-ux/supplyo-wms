  <diagram id="p24" name="24 · Ozon: этикетки и печать">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title-24" value="24 · Ozon: этикетки и печать" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=34;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="70" y="20" width="1360" height="65" as="geometry" />
        </mxCell>
        <mxCell id="scope-24" value="Разрешённый кабинет / склад / компьютер / принтер" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=21;fontColor=#64748B;" parent="1" vertex="1">
          <mxGeometry x="70" y="90" width="1360" height="45" as="geometry" />
        </mxCell>
        <mxCell id="status-24" value="Реализация: Печать после подтверждённой сборки. API, PDF и агент проверены fixtures; реальный Ozon кабинет и бумага требуют проверки." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=18;fontColor=#64748B;" parent="1" vertex="1">
          <mxGeometry x="70" y="140" width="1360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="24-ready" value="ОЖИДАЕТ ОТГРУЗКИ&#10;Печать в списке заказов или после&#10;завершения сборки. Проверить склад,&#10;подписку и право сборки." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="518.9999999999998" y="280" width="460" height="184" as="geometry" />
        </mxCell>
        <mxCell id="24-agent" value="АГЕНТ И ПРИНТЕР&#10;Проверить mediaSizes и постоянный ID&#10;компьютера. Выбранный принтер&#10;фиксируется в задании." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="518.9999999999998" y="584" width="460" height="184" as="geometry" />
        </mxCell>
        <mxCell id="24-queue" value="ПОСТОЯННОЕ ЗАДАНИЕ&#10;Один незавершённый job на&#10;отправление. Другой компьютер не&#10;получает его для повторной печати." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="181.33333333333326" y="888" width="460" height="184" as="geometry" />
        </mxCell>
        <mxCell id="24-create" value="СФОРМИРОВАТЬ ЭТИКЕТКУ&#10;Ozon v3 create → small_label или&#10;big_label. Общая подготовка и&#10;ожидание очереди, 429 сохраняет&#10;паузу." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="181.33333333333326" y="1192" width="460" height="212" as="geometry" />
        </mxCell>
        <mxCell id="24-get" value="ПОЛУЧИТЬ PDF&#10;Ozon v2 get: только completed и&#10;полный результат одного отправления,&#10;без unprinted ошибок." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="181.33333333333326" y="1524" width="460" height="184" as="geometry" />
        </mxCell>
        <mxCell id="24-render" value="ПОДГОТОВИТЬ СТРАНИЦЫ&#10;Только HTTPS Ozon CDN, лимиты&#10;PDF/страниц. Poppler 300 dpi сохраняет&#10;CropBox и поворот, размеры в мм." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="258" y="1974" width="460" height="184" as="geometry" />
        </mxCell>
        <mxCell id="24-print" value="ПЕЧАТЬ&#10;Неизменяемые PNG + размеры →&#10;существующий агент. Job ID и привязка&#10;к устройству защищают повтор." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="864.6666666666665" y="2278" width="460" height="184" as="geometry" />
        </mxCell>
        <mxCell id="24-receipt" value="ПОДТВЕРЖДЕНИЕ&#10;Только после ответа агента сохранить&#10;квитанцию. Потеря ответа → тот же&#10;job/тело без нового экземпляра." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="941.3333333333333" y="2582" width="460" height="184" as="geometry" />
        </mxCell>
        <mxCell id="24-again" value="НАМЕРЕННЫЙ ПОВТОР&#10;Отдельное подтверждение, новый job&#10;ID. Используется сохранённая&#10;этикетка." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#FFE9D5;strokeColor=#C99768;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="864.6666666666665" y="3032" width="460" height="184" as="geometry" />
        </mxCell>
        <mxCell id="24-error" value="ОШИБКА / СТАРЫЙ АГЕНТ&#10;Не печатать неполный PDF.&#10;Предложить обновление агента или&#10;безопасный повтор подготовки." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#FFE3DE;strokeColor=#D37D6A;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
