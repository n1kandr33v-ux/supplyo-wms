        <mxCell id="02-edge-2" value="Тестовый сценарий" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontColor=#233044;fontSize=18;fontFamily=Arial;labelBackgroundColor=#FFFFFF;exitX=0.3333333333333334;exitY=1.0;entryX=0.5;entryY=0.0;exitPerimeter=0;entryPerimeter=0;" parent="1" edge="1" source="02-choose" target="02-test">
          <mxGeometry relative="1" as="geometry" />
