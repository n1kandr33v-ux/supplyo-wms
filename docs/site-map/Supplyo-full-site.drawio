  <diagram id="p14" name="14 · Поставки, остатки и размещение">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title-14" value="14 · Поставки, остатки и размещение" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=34;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="70" y="20" width="3397" height="65" as="geometry" />
        </mxCell>
        <mxCell id="scope-14" value="По разрешённому кабинету и складу" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=21;fontColor=#64748B;" parent="1" vertex="1">
          <mxGeometry x="70" y="90" width="3397" height="45" as="geometry" />
        </mxCell>
        <mxCell id="status-14" value="Реализация: Полная таблица поставок, фильтр периода, остатки WB, код/адрес, права и CSV реализованы." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=18;fontColor=#64748B;" parent="1" vertex="1">
          <mxGeometry x="70" y="140" width="3397" height="80" as="geometry" />
        </mxCell>
        <mxCell id="14-sup" value="ПОСТАВКИ&#10;Только разрешённый склад и кабинет.&#10;В поставке всегда один склад." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="736.6666666666666" y="280" width="460" height="156" as="geometry" />
        </mxCell>
        <mxCell id="14-stock" value="ОСТАТКИ И РАЗМЕЩЕНИЕ&#10;Каталог и остатки WB загружаются в&#10;фоне.&#10;Только разрешённый кабинет и склад.&#10;Сотрудник — в рамках назначенных&#10;прав." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="2776.6666666666665" y="280" width="460" height="240" as="geometry" />
        </mxCell>
        <mxCell id="14-period" value="ФИЛЬТР ПО ДАТЕ СОЗДАНИЯ&#10;Начало → конец, обе границы&#10;включительно; сброс в календаре.&#10;Даты фильтра и время таблицы —&#10;Europe/Moscow, а не часовой пояс&#10;браузера." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="736.6666666666666" y="556" width="460" height="240" as="geometry" />
        </mxCell>
        <mxCell id="14-filters" value="ФИЛЬТРЫ ОСТАТКОВ&#10;Поиск по товару / всем баркодам /&#10;коде.&#10;«В наличии» или «Все товары»." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="2853.333333333333" y="677.3333333333333" width="460" height="184" as="geometry" />
        </mxCell>
        <mxCell id="14-history" value="ПОЛНАЯ СТРОКА ПОСТАВКИ&#10;Название и ID · склад · создана ·&#10;передана · без КИЗ / с КИЗ · короба ·&#10;СЦ/ПВЗ · статус · печать стикера.&#10;sgtin в requiredMeta или optionalMeta&#10;считается КИЗ." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="736.6666666666666" y="916" width="460" height="240" as="geometry" />
        </mxCell>
        <mxCell id="14-summary" value="ИТОГИ ОСТАТКОВ&#10;Общий остаток, позиций в наличии.&#10;Все баркоды: первый крупнее,&#10;остальные меньше." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="2930" y="1028" width="460" height="184" as="geometry" />
        </mxCell>
        <object id="14-open" label="НА СБОРКЕ&#10;Название и статус выглядят&#10;нажимаемыми.&#10;Открыть именно эту поставку → 10." link="data:page/id,p10">
          <mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#EDE6FF;strokeColor=#9C83CF;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
            <mxGeometry x="660" y="1422" width="460" height="184" as="geometry" />
          </mxCell>
        </object>
        <object id="14-closed" label="ПЕРЕДАНА&#10;История отгрузки сохраняется.&#10;Повторная печать этикеток → 13.&#10;Не передавать снова." link="data:page/id,p13">
          <mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#EDE6FF;strokeColor=#9C83CF;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
            <mxGeometry x="1220" y="1422" width="460" height="184" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="14-edit" value="РЕДАКТИРОВАТЬ ОСТАТКИ&#10;Код, адрес, количество.&#10;«шт.» отдельно, сетка не скачет.&#10;Код/адрес — локальные данные&#10;supply." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="2930" y="1360" width="460" height="212" as="geometry" />
        </mxCell>
        <mxCell id="14-rights" value="Есть право&#10;изменения остатков?" style="rhombus;whiteSpace=wrap;html=0;fillColor=#FFF0C9;strokeColor=#C99726;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="2930" y="1692" width="460" height="220" as="geometry" />
        </mxCell>
        <mxCell id="14-read" value="ТОЛЬКО ПРОСМОТР&#10;Значения видны, редактирование&#10;заблокировано.&#10;Причина доступна пользователю." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#FFF0C9;strokeColor=#C99726;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="3006.6666666666665" y="2178" width="460" height="184" as="geometry" />
        </mxCell>
        <mxCell id="14-save" value="СОХРАНИТЬ ИЗМЕНЕНИЕ&#10;Проверить число, версию и&#10;разрешённый склад.&#10;Количество → WB PUT и контроль&#10;чтением.&#10;Код / адрес → база supply; количества&#10;от импорта размещения не меняются." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="2446.6666666666665" y="2178" width="460" height="268" as="geometry" />
        </mxCell>
        <mxCell id="14-ui" value="ОБЩИЙ ВИД ТАБЛИЦ&#10;Ровная подсветка всей строки,&#10;фиксированные колонки, длинные&#10;названия переносятся.&#10;Серое окончание без «Показано N&#10;позиций»." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#F5F6F8;strokeColor=#A5AFBE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="70" y="280" width="460" height="240" as="geometry" />
        </mxCell>
        <mxCell id="14-export" value="ЭКСПОРТ ОСТАТКОВ&#10;CSV по разрешённому кабинету/складу&#10;и текущему фильтру.&#10;Другие склады не попадают в файл." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="2370" y="1000" width="460" height="184" as="geometry" />
        </mxCell>
        <mxCell id="14-import" value="РАЗМЕЩЕНИЕ ИЗ ТАБЛИЦЫ&#10;Точное сопоставление баркода и&#10;карточки/размера; только нужный&#10;кабинет и склад.&#10;Неоднозначное не подставлять. Бэкап&#10;и контроль неизменности количества." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#F5F6F8;strokeColor=#A5AFBE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1810" y="640" width="460" height="240" as="geometry" />
        </mxCell>
        <mxCell id="14-catalog" value="НОВЫЕ ПОЗИЦИИ КАТАЛОГА&#10;Разовый перенос не равен постоянной&#10;синхронизации с Google Sheets.&#10;Товары, не найденные при импорте,&#10;требуют отдельного повторного&#10;сопоставления." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#F5F6F8;strokeColor=#A5AFBE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1810" y="1000" width="460" height="240" as="geometry" />
        </mxCell>
