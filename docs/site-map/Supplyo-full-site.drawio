        <mxCell id="20-edge-4" value="Нет данных" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontColor=#233044;fontSize=18;fontFamily=Arial;labelBackgroundColor=#FFFFFF;exitX=0.33333333333333315;exitY=1.0;entryX=0.6666666666666669;entryY=0.0;exitPerimeter=0;entryPerimeter=0;" parent="1" edge="1" source="20-supply" target="20-empty">
