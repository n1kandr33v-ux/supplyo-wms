  <diagram id="p13" name="13 · Печать: настройки, агент и повтор">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title-13" value="13 · Печать: настройки, агент и повтор" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=34;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="70" y="20" width="2177" height="65" as="geometry" />
        </mxCell>
        <mxCell id="scope-13" value="Каждое рабочее место сборщика" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=21;fontColor=#64748B;" parent="1" vertex="1">
          <mxGeometry x="70" y="90" width="2177" height="45" as="geometry" />
        </mxCell>
        <mxCell id="status-13" value="Реализация: Windows-агент, диагностика, одиночная и пакетная печать и безопасный повтор реализованы. Подписанный установщик — план." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=18;fontColor=#64748B;" parent="1" vertex="1">
          <mxGeometry x="70" y="140" width="2177" height="80" as="geometry" />
        </mxCell>
        <mxCell id="13-settings" value="НАСТРОЙКИ → ПЕЧАТЬ ЭТИКЕТОК&#10;Поиск принтеров и скачивание агента&#10;находятся здесь, а не в таблице&#10;сборки." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1365" y="280" width="460" height="184" as="geometry" />
        </mxCell>
        <mxCell id="13-install" value="ЗАПУСТИТЬ АГЕНТ WINDOWS&#10;Скачать один supply-print-agent.exe →&#10;открыть. Без архива и установки,&#10;работает в трее. После перезапуска&#10;Windows открыть снова." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1288.3333333333333" y="584" width="460" height="212" as="geometry" />
        </mxCell>
        <mxCell id="13-discover" value="АВТОМАТИЧЕСКОЕ ПОДКЛЮЧЕНИЕ&#10;В настройках каждые 5 секунд&#10;проверяется агент. Принтер Windows&#10;по умолчанию выбирается&#10;автоматически, выбор можно изменить." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1365" y="916" width="460" height="212" as="geometry" />
        </mxCell>
        <mxCell id="13-select" value="ВЫБРАТЬ ПРИНТЕР&#10;Сохранить выбор для этого рабочего&#10;места / браузера.&#10;Проверить формат этикетки." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1365" y="1248" width="460" height="184" as="geometry" />
        </mxCell>
        <mxCell id="13-job" value="ЗАДАНИЕ ПЕЧАТИ&#10;10 — товар без КИЗ&#10;11 — товар с КИЗ&#10;12 / 14 — поставка / короба.&#10;Передать файл этикетки, не всю&#10;страницу." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1365" y="1552" width="460" height="240" as="geometry" />
        </mxCell>
        <mxCell id="13-agent" value="ЛОКАЛЬНЫЙ АГЕНТ&#10;Для «Авто» получить все этикетки и&#10;заранее загрузить все изображения.&#10;Затем одно PrintDocument / одно&#10;задание очереди Windows.&#10;Вернуть результат принятия задания&#10;целиком." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1365" y="1912" width="460" height="268" as="geometry" />
        </mxCell>
        <mxCell id="13-ack" value="ЗАДАНИЕ ПРИНЯТО&#10;Обновить результат печати заказа.&#10;Ответ очереди Windows не доказывает&#10;физический выход бумаги." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#DFF4E4;strokeColor=#65A773;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1250" y="2446" width="460" height="184" as="geometry" />
        </mxCell>
        <mxCell id="13-err" value="АГЕНТ НЕДОСТУПЕН&#10;Отдельная понятная ошибка: запустить&#10;supply-print-agent.exe, проверить&#10;настройки печати и доступ к локальной&#10;сети.&#10;Сбой сервера supply показывается&#10;отдельно. Сохранённое задание&#10;остаётся для повтора." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#FFE3DE;strokeColor=#D37D6A;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1787" y="2750" width="460" height="296" as="geometry" />
        </mxCell>
        <mxCell id="13-repeat" value="ПОВТОР И ПЕРЕПЕЧАТКА&#10;Сбой агента или подтверждения: тот&#10;же job ID, принтер и файлы.&#10;duplicate означает прежнее принятие в&#10;очередь. Явная новая перепечатка —&#10;новый job ID." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1518" y="3166" width="460" height="240" as="geometry" />
        </mxCell>
        <mxCell id="13-safe" value="БЕЗОПАСНОСТЬ АГЕНТА&#10;Доверенные источники и привязка&#10;рабочего места.&#10;Секрет WB не передавать принтеру." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#FFE9D5;strokeColor=#C99768;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="70" y="280" width="460" height="184" as="geometry" />
        </mxCell>
        <mxCell id="13-installer" value="ПЛАН ДЛЯ КЛИЕНТОВ&#10;Цифровая подпись, установщик,&#10;автозапуск и обновления. Сейчас&#10;переносимый EXE без подписи; журнал&#10;ошибок уже есть." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#FFE9D5;strokeColor=#C99768;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="660" y="280" width="460" height="212" as="geometry" />
        </mxCell>
        <mxCell id="13-edge-0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontColor=#233044;fontSize=18;fontFamily=Arial;labelBackgroundColor=#FFFFFF;exitX=0.33333333333333315;exitY=1.0;entryX=0.5;entryY=0.0;exitPerimeter=0;entryPerimeter=0;" parent="1" edge="1" source="13-settings" target="13-install">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="13-edge-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontColor=#233044;fontSize=18;fontFamily=Arial;labelBackgroundColor=#FFFFFF;exitX=0.6666666666666669;exitY=1.0;entryX=0.6666666666666669;entryY=0.0;exitPerimeter=0;entryPerimeter=0;" parent="1" edge="1" source="13-settings" target="13-discover">
          <mxGeometry relative="1" as="geometry">
