        </mxCell>
        <mxCell id="11-revision" value="ЗАЩИТА НОВОГО СКАНА&#10;Ответ применяется только к тем же&#10;КИЗ, revision и прежнему решению.&#10;Запоздавший ответ не подтверждает&#10;новый КИЗ." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#F5F6F8;strokeColor=#A5AFBE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
