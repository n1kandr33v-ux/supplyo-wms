        <mxCell id="title-17" value="17 · Счета клиентам → чек → доход" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=34;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="70" y="20" width="1360" height="65" as="geometry" />
        </mxCell>
        <mxCell id="scope-17" value="Владелец / финансовый доступ" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=21;fontColor=#64748B;" parent="1" vertex="1">
          <mxGeometry x="70" y="90" width="1360" height="45" as="geometry" />
        </mxCell>
        <mxCell id="status-17" value="Реализация: Счета, обязательное подтверждение оплаты и доход есть. Юридический документооборот — отдельная интеграция." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=18;fontColor=#64748B;" parent="1" vertex="1">
          <mxGeometry x="70" y="140" width="1360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="17-new" value="СОЗДАТЬ СЧЁТ&#10;Склад, дата, номер, вид операции,&#10;описание, контрагент, сумма, срок&#10;оплаты, документы." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="223.33333333333331" y="280" width="460" height="184" as="geometry" />
        </mxCell>
        <mxCell id="17-pending" value="СЧЕТА КЛИЕНТАМ&#10;Только ожидающие оплаты.&#10;Сумма выставленных / ожидающих за&#10;выбранные даты." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="223.33333333333331" y="584" width="460" height="184" as="geometry" />
        </mxCell>
        <mxCell id="17-mark" value="ОТМЕТИТЬ ОПЛАТУ&#10;Открывается окно подтверждения с&#10;данными счёта." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="223.33333333333331" y="888" width="460" height="156" as="geometry" />
        </mxCell>
        <mxCell id="17-receipt" value="ПРИКРЕПИТЬ ЧЕК&#10;Обязательный файл или фото.&#10;Проверить загрузку, тип и размер." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="223.33333333333331" y="1164" width="460" height="156" as="geometry" />
        </mxCell>
        <mxCell id="17-check" value="Чек загружен&#10;и данные корректны?" style="rhombus;whiteSpace=wrap;html=0;fillColor=#FFF0C9;strokeColor=#C99726;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="223.33333333333331" y="1440" width="460" height="220" as="geometry" />
        </mxCell>
        <mxCell id="17-error" value="НЕТ ЧЕКА / СБОЙ ЗАГРУЗКИ&#10;Счёт остаётся неоплаченным.&#10;Показать ошибку возле поля." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#FFE3DE;strokeColor=#D37D6A;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="706.6666666666666" y="1926" width="460" height="156" as="geometry" />
        </mxCell>
        <mxCell id="17-atomic" value="ПОДТВЕРДИТЬ ОПЛАТУ&#10;Одновременно отметить счёт&#10;оплаченным и создать доход по этому&#10;счёту.&#10;Повтор не создаёт второй доход." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="146.66666666666666" y="1926" width="460" height="212" as="geometry" />
        </mxCell>
        <mxCell id="17-income" value="ДОХОД → 15&#10;Дата оплаты, вид операции счёта,&#10;контрагент, сумма и чек.&#10;Виден при соответствующем периоде." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#DFF4E4;strokeColor=#65A773;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="630" y="2258" width="460" height="184" as="geometry" />
        </mxCell>
        <mxCell id="17-hide" value="УХОДИТ ИЗ ОЖИДАЮЩИХ&#10;История счёта и документы&#10;сохраняются.&#10;Это не удаление счёта из базы." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#DFF4E4;strokeColor=#65A773;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="70" y="2258" width="460" height="184" as="geometry" />
        </mxCell>
        <mxCell id="17-correct" value="ИСПРАВИТЬ / УДАЛИТЬ&#10;Связанные доход и счёт&#10;корректировать согласованно, с&#10;подтверждением и журналом." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#FFE9D5;strokeColor=#C99768;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
