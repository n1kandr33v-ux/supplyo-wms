  <diagram id="p07" name="07 · Сотрудник: добавление, вход и права">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title-07" value="07 · Сотрудник: добавление, вход и права" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=34;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="70" y="20" width="2140" height="65" as="geometry" />
        </mxCell>
        <mxCell id="scope-07" value="Администратор склада → сотрудник" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=21;fontColor=#64748B;" parent="1" vertex="1">
          <mxGeometry x="70" y="90" width="2140" height="45" as="geometry" />
        </mxCell>
        <mxCell id="status-07" value="Реализация: Назначение по email. Письма-приглашения не отправляются." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=18;fontColor=#64748B;" parent="1" vertex="1">
          <mxGeometry x="70" y="140" width="2140" height="80" as="geometry" />
        </mxCell>
        <mxCell id="07-admin" value="Главный администратор /&#10;управляющий&#10;06 Склады → Добавить сотрудника." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="146.66666666666666" y="280" width="460" height="156" as="geometry" />
        </mxCell>
        <mxCell id="07-form" value="ФИО + email сотрудника&#10;Выдать конкретные разрешения на&#10;ЭТОМ складе.&#10;Без кнопок-предустановок ролей." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="146.66666666666666" y="556" width="460" height="184" as="geometry" />
        </mxCell>
        <mxCell id="07-rights" value="ПРАВА&#10;Просмотр заказов и остатков&#10;Сборка / КИЗ / печать&#10;Создание поставок / доставка&#10;Изменение остатков / размещения&#10;Управление складом / сотрудниками" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="146.66666666666666" y="916" width="460" height="240" as="geometry" />
        </mxCell>
        <mxCell id="07-save" value="Сохранить назначение&#10;У аккаунта работодателя активна&#10;подписка.&#10;В карточке сотрудник: ФИО, затем&#10;email." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="146.66666666666666" y="1332" width="460" height="212" as="geometry" />
        </mxCell>
        <mxCell id="07-person" value="СОТРУДНИК&#10;Открывает сайт и регистрируется /&#10;входит с ТОЧНО ТЕМ email, который&#10;добавили." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="898.3333333333334" y="556" width="460" height="184" as="geometry" />
        </mxCell>
        <mxCell id="07-resolve" value="Сервер сопоставляет&#10;email&#10;Находит назначения,&#10;активного работодателя&#10;и привязки складов WB." style="rhombus;whiteSpace=wrap;html=0;fillColor=#FFF0C9;strokeColor=#C99726;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="898.3333333333334" y="860" width="460" height="352" as="geometry" />
        </mxCell>
        <mxCell id="07-nothing" value="Доступ не найден&#10;Проверить email, назначение на склад,&#10;подписку работодателя и WB-привязку.&#10;Личная покупка подписки проблему не&#10;решает." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#FFE3DE;strokeColor=#D37D6A;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1305" y="1664" width="460" height="212" as="geometry" />
        </mxCell>
        <mxCell id="07-scoped" value="Разрешённый рабочий контекст&#10;Только назначенный физический склад&#10;и его кабинеты / склады WB.&#10;Личная подписка не нужна.&#10;Подключение второго клиента не&#10;обнуляет доступ к первому.&#10;Отзыв действует только на выбранный&#10;кабинет." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#DFF4E4;strokeColor=#65A773;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="745" y="1664" width="460" height="296" as="geometry" />
        </mxCell>
        <object id="07-work" label="08 Обзор → работа по правам&#10;Просмотр → 09 / 14&#10;Сборка → 10 / 11 / 13&#10;Отгрузка → 12" link="data:page/id,p08">
          <mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#EDE6FF;strokeColor=#9C83CF;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
            <mxGeometry x="1190" y="2080" width="460" height="184" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="07-manage" value="Изменить сотрудника&#10;Кнопки редактирования ФИО / email.&#10;Изменить права или удалить доступ." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="70" y="1734" width="460" height="156" as="geometry" />
        </mxCell>
        <mxCell id="07-denied" value="Защита&#10;Нельзя получить чужие склады,&#10;API-ключи, чужую бухгалтерию&#10;или повысить собственные права." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#FFE3DE;strokeColor=#D37D6A;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1750" y="2080" width="460" height="184" as="geometry" />
        </mxCell>
        <mxCell id="07-revoke" value="Удалён доступ / истекла подписка ФФ&#10;Сервер прекращает доступ к&#10;операциям.&#10;Уже открытая вкладка не сохраняет&#10;старые права." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="70" y="2080" width="460" height="212" as="geometry" />
        </mxCell>
        <mxCell id="07-other" value="Несколько работодателей / свои&#10;магазины&#10;Аккаунт остаётся одним.&#10;Каждый ресурс проверяется отдельно." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#F5F6F8;strokeColor=#A5AFBE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="630" y="2080" width="460" height="184" as="geometry" />
        </mxCell>
