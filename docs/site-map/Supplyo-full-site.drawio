              <mxPoint x="3490.3333333333335" y="586" />
              <mxPoint x="2284.3333333333335" y="586" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="10-edge-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontColor=#233044;fontSize=18;fontFamily=Arial;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1.0;entryX=0.33333333333333315;entryY=0.0;exitPerimeter=0;entryPerimeter=0;" parent="1" edge="1" source="10-focus" target="10-scan">
