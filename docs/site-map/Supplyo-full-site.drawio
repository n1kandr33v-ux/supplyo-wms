  <diagram id="p03" name="03 · Навигация и проверка прав">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title-03" value="03 · Навигация и проверка прав" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=34;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="70" y="20" width="2531" height="65" as="geometry" />
        </mxCell>
        <mxCell id="scope-03" value="Все роли" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=21;fontColor=#64748B;" parent="1" vertex="1">
          <mxGeometry x="70" y="90" width="2531" height="45" as="geometry" />
        </mxCell>
        <mxCell id="status-03" value="Реализация: Разделы серверной версии. Проверки на сервере обязательны." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=18;fontColor=#64748B;" parent="1" vertex="1">
          <mxGeometry x="70" y="140" width="2531" height="80" as="geometry" />
        </mxCell>
        <mxCell id="03-logo" value="ЛОГО SUPPLY&#10;Всегда открывает 08 Обзор, в том&#10;числе без подписки.&#10;Плавное сужение меню: правая часть&#10;слова скрывается, S остаётся на&#10;месте." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1296.6666666666665" y="280" width="460" height="240" as="geometry" />
        </mxCell>
        <mxCell id="03-nav" value="ОСНОВНОЕ МЕНЮ&#10;Новые заказы → 09&#10;Сборка → 10 / 11 / 12&#10;Поставки → 14&#10;Остатки → 14" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="736.6666666666666" y="658.6666666666667" width="460" height="212" as="geometry" />
        </mxCell>
        <mxCell id="03-settings" value="МЕНЮ «НАСТРОЙКИ»&#10;Магазины → 04&#10;Доступ фулфилменту → 05&#10;Клиенты → 05&#10;Печать → 13&#10;Подписка → 02" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1856.6666666666665" y="640" width="460" height="240" as="geometry" />
        </mxCell>
        <mxCell id="03-profile" value="МЕНЮ АККАУНТА&#10;Профиль → 18&#10;Склады / сотрудники → 06 / 07&#10;Учёт → 15–17&#10;Выйти → закрыть сессию" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1296.6666666666665" y="654" width="460" height="212" as="geometry" />
        </mxCell>
        <mxCell id="03-auth" value="Проверка каждой&#10;операции&#10;Кто вошёл? Чей ресурс?&#10;Какие кабинет и склад&#10;разрешены?&#10;Активна ли нужная&#10;подписка?&#10;Есть ли право на&#10;действие?" style="rhombus;whiteSpace=wrap;html=0;fillColor=#FFF0C9;strokeColor=#C99726;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1296.6666666666665" y="1000" width="460" height="576" as="geometry" />
        </mxCell>
        <mxCell id="03-own" value="СВОЙ МАГАЗИН&#10;Добавить API / выдать доступ: без&#10;подписки.&#10;Работать в ВМС: нужна собственная&#10;подписка." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1810.6666666666665" y="1696" width="460" height="212" as="geometry" />
        </mxCell>
        <mxCell id="03-grant" value="КЛИЕНТСКИЙ МАГАЗИН&#10;Принятый и неотозванный доступ +&#10;подписка ФФ.&#10;Ровно один разрешённый склад WB." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1250.6666666666665" y="1710" width="460" height="184" as="geometry" />
        </mxCell>
        <mxCell id="03-employee" value="СОТРУДНИК&#10;Назначение по email + физический&#10;склад + привязки WB + конкретные&#10;права.&#10;Личная подписка не требуется." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="690.6666666666666" y="1696" width="460" height="212" as="geometry" />
        </mxCell>
        <mxCell id="03-deny" value="Доступа нет&#10;Кнопка неактивна, при наведении&#10;понятная причина.&#10;Прямой запрос к API тоже отклоняется." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#FFE3DE;strokeColor=#D37D6A;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="2140.6666666666665" y="2028" width="460" height="184" as="geometry" />
        </mxCell>
        <mxCell id="03-allow" value="Доступ разрешён&#10;Только разрешённые данные и&#10;действия.&#10;Смена кабинета не даёт доступ к&#10;чужому складу." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#DFF4E4;strokeColor=#65A773;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="805.6666666666666" y="2028" width="460" height="212" as="geometry" />
        </mxCell>
        <mxCell id="03-mixed" value="СОВМЕЩЕНИЕ РОЛЕЙ&#10;Можно иметь несколько своих API и&#10;принять код клиента.&#10;Сервер объединяет разрешённые&#10;ресурсы, сохраняя ограничения&#10;каждого." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#F5F6F8;strokeColor=#A5AFBE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="70" y="280" width="460" height="240" as="geometry" />
        </mxCell>
        <mxCell id="03-restore" value="ПОСЛЕ ОБНОВЛЕНИЯ СТРАНИЦЫ&#10;В том же аккаунте и вкладке&#10;восстановить раздел, кабинет и&#10;выбранную поставку.&#10;Не возвращать автоматически в&#10;«Новые заказы»." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="805.6666666666666" y="2360" width="460" height="240" as="geometry" />
        </mxCell>
        <mxCell id="03-motion" value="ПЛАВНЫЕ ПЕРЕХОДЫ&#10;Открытие разделов, меню, окон и&#10;боковой панели. Профиль и настройки&#10;не прыгают.&#10;Фоновое обновление не повторяет&#10;анимацию. Учитывается&#10;reduced-motion." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#F5F6F8;strokeColor=#A5AFBE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="660" y="1000" width="460" height="268" as="geometry" />
        </mxCell>
        <mxCell id="03-edge-0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontColor=#233044;fontSize=18;fontFamily=Arial;labelBackgroundColor=#FFFFFF;exitX=0.25;exitY=1.0;entryX=0.5;entryY=0.0;exitPerimeter=0;entryPerimeter=0;" parent="1" edge="1" source="03-logo" target="03-nav">
