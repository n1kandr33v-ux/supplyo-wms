        <mxCell id="notes-14" value="Открытая поставка доступна по названию и статусу «На сборке». Старые записи без warehouse_id определяются по единственному складу сохранённых заказов; неизвестные значения не придумываются." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=20;fontColor=#475569;" parent="1" vertex="1">
          <mxGeometry x="70" y="2521" width="3397" height="60" as="geometry" />
        </mxCell>
        <object id="back-14" label="← К оглавлению" link="data:page/id,index">
          <mxCell style="rounded=1;html=0;fillColor=#EDE6FF;strokeColor=#9C83CF;fontSize=20;fontFamily=Arial;" parent="1" vertex="1">
            <mxGeometry x="70" y="2601" width="260" height="50" as="geometry" />
          </mxCell>
        </object>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p15" name="15 · Учёт: доходы, расходы и прибыль">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title-15" value="15 · Учёт: доходы, расходы и прибыль" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=34;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="70" y="20" width="1657" height="65" as="geometry" />
        </mxCell>
        <mxCell id="scope-15" value="Владелец; иные роли — только при отдельном разрешении" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=21;fontColor=#64748B;" parent="1" vertex="1">
          <mxGeometry x="70" y="90" width="1657" height="45" as="geometry" />
        </mxCell>
        <mxCell id="status-15" value="Реализация: Записи и документы сохраняются сервером; финансовые права требуют отдельной политики." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=18;fontColor=#64748B;" parent="1" vertex="1">
          <mxGeometry x="70" y="140" width="1657" height="80" as="geometry" />
        </mxCell>
        <mxCell id="15-store" value="УЧЁТ → ВЫБРАТЬ ФИЗИЧЕСКИЙ&#10;СКЛАД&#10;Учёт ведётся отдельно по каждому&#10;складу фулфилмента.&#10;Это не склад WB клиента." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="630" y="280" width="460" height="212" as="geometry" />
        </mxCell>
        <mxCell id="15-period" value="ПЕРИОД ПО УМОЛЧАНИЮ —&#10;ТЕКУЩИЙ МЕСЯЦ&#10;При переключении месяца выбирается&#10;весь месяц.&#10;Пользователь может выбрать другой&#10;интервал." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="630" y="612" width="460" height="240" as="geometry" />
        </mxCell>
        <mxCell id="15-totals" value="ДОХОДЫ / РАСХОДЫ / ПРИБЫЛЬ&#10;Итоги зависят от склада и дат.&#10;Поиск и вид операции меняют список,&#10;а не общие итоги." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="706.6666666666667" y="972" width="460" height="184" as="geometry" />
        </mxCell>
        <mxCell id="15-table" value="ОПЕРАЦИИ&#10;Дата → вид операции → описание →&#10;контрагент → сумма → доход / расход." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="146.66666666666674" y="988.8" width="460" height="156" as="geometry" />
        </mxCell>
        <mxCell id="15-filter" value="ПОИСК И ВИД ОПЕРАЦИИ&#10;Материалы, зарплата, аренда, услуги&#10;фулфилмента, хранение, другое." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="70" y="696" width="460" height="156" as="geometry" />
        </mxCell>
        <mxCell id="15-manual" value="ДОБАВИТЬ ДОХОД / РАСХОД&#10;Дата, вид операции, описание,&#10;контрагент, сумма, файл / фото&#10;документа." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="146.66666666666674" y="1290" width="460" height="184" as="geometry" />
        </mxCell>
        <object id="15-auto" label="АВТОМАТИЧЕСКИЕ ОПЕРАЦИИ&#10;16 Выплата сотруднику → расход.&#10;17 Оплаченный счёт → доход.&#10;Без двойного учёта." link="data:page/id,p16">
          <mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#EDE6FF;strokeColor=#9C83CF;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
            <mxGeometry x="706.6666666666667" y="1304" width="460" height="184" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="15-save" value="СОХРАНИТЬ ОПЕРАЦИЮ&#10;Проверить склад, сумму и доступ к&#10;файлам.&#10;Обновить список и итоги." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="591.6666666666667" y="1608" width="460" height="184" as="geometry" />
        </mxCell>
        <mxCell id="15-edit" value="ИЗМЕНИТЬ / УДАЛИТЬ&#10;Подтверждение показывает описание и&#10;имя контрагента.&#10;Обычная запись удаляется после&#10;подтверждения." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1266.6666666666667" y="1276" width="460" height="212" as="geometry" />
        </mxCell>
        <mxCell id="15-linked" value="СВЯЗАННАЯ ЗАПИСЬ&#10;Удаление / исправление дохода по&#10;счёту или выплаты должно&#10;согласованно исправлять источник.&#10;Не оставлять оплаченный счёт без&#10;дохода." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#FFE9D5;strokeColor=#C99768;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1266.6666666666667" y="1912" width="460" height="240" as="geometry" />
        </mxCell>
        <mxCell id="15-docs" value="ДОКУМЕНТЫ&#10;Просмотр / скачивание вложений&#10;только пользователями с доступом к&#10;записи.&#10;Файлы сохраняются с записью." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="591.6666666666667" y="1912" width="460" height="212" as="geometry" />
        </mxCell>
