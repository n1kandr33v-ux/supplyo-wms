        <mxCell id="22-edge-12" value="Сборка" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontColor=#233044;fontSize=18;fontFamily=Arial;labelBackgroundColor=#FFFFFF;exitX=0.5000000000000002;exitY=1.0;entryX=0.5000000000000002;entryY=0.0;exitPerimeter=0;entryPerimeter=0;" parent="1" edge="1" source="22-list" target="22-next">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="notes-22" value="Действующая документация Ozon Seller API проверена в браузере: SellerAPI_SellerInfo, WarehouseListV2, PostingFbsList. Тестовые ответы не подменяют проверку пользовательского кабинета. API-ключи и персональные данные в схеме отсутствуют. Автоматически читаются атрибут маркировки 23536 и ТН ВЭД 22232 по SKU: пакетами по 100, кеш сутки, ручное обновление перечитывает. Нет/неоднозначный признак — неизвестно; ошибка не стирает сохранённые данные. Это признак карточки, а не проверка конкретного КИЗ и не требование передачи кода по заказу. Уточнение интерфейса: признаки маркировки и ТН ВЭД скрыты из списка товаров. Для будущей сборки согласован сценарий WB: система сама запрашивает КИЗ после скана, только когда он нужен; сборка Ozon пока не реализована. Сборка и запись КИЗ теперь подключены — см. главу 23. Печать этикеток, многокоробочная сборка, отгрузочные документы и остатки Ozon остаются отдельными этапами. Печать этикеток Ozon подключена в главе 24; документы перевозки и остатки остаются отдельными этапами." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=20;fontColor=#475569;" parent="1" vertex="1">
          <mxGeometry x="70" y="3285" width="1469" height="239" as="geometry" />
        </mxCell>
        <object id="back-22" label="← К оглавлению" link="data:page/id,index">
          <mxCell style="rounded=1;html=0;fillColor=#EDE6FF;strokeColor=#9C83CF;fontSize=20;fontFamily=Arial;" parent="1" vertex="1">
            <mxGeometry x="70" y="3529" width="260" height="50" as="geometry" />
          </mxCell>
        </object>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p23" name="23 · Ozon: сборка и сохранение КИЗ">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0">
