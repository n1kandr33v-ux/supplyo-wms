        </mxCell>
        <mxCell id="19-edge-2" value="Действие / обновление" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontColor=#233044;fontSize=18;fontFamily=Arial;labelBackgroundColor=#FFFFFF;exitX=0.6666666666666669;exitY=1.0;entryX=0.6666666666666663;entryY=0.0;exitPerimeter=0;entryPerimeter=0;" parent="1" edge="1" source="19-server" target="19-queue">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1374.3333333333333" y="860" />
              <mxPoint x="3236.3333333333335" y="860" />
              <mxPoint x="3236.3333333333335" y="1228" />
              <mxPoint x="2843.666666666667" y="1228" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="19-edge-3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontColor=#233044;fontSize=18;fontFamily=Arial;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;exitPerimeter=0;entryPerimeter=0;" parent="1" edge="1" source="19-queue" target="19-limits">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="19-edge-4" value="Разрешён запрос" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontColor=#233044;fontSize=18;fontFamily=Arial;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;exitPerimeter=0;entryPerimeter=0;" parent="1" edge="1" source="19-limits" target="19-wb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="19-edge-5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontColor=#233044;fontSize=18;fontFamily=Arial;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1.0;entryX=0.6666666666666669;entryY=0.0;exitPerimeter=0;entryPerimeter=0;" parent="1" edge="1" source="19-wb" target="19-cache">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="2767" y="2426" />
              <mxPoint x="966.6666666666667" y="2426" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="19-edge-6" value="Запись" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontColor=#233044;fontSize=18;fontFamily=Arial;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1.0;entryX=0.3333333333333334;entryY=0.0;exitPerimeter=0;entryPerimeter=0;" parent="1" edge="1" source="19-cache" target="19-db">
