          <mxGeometry x="70" y="90" width="1580" height="45" as="geometry" />
        </mxCell>
        <mxCell id="status-02" value="Реализация: Тестовая активация есть. Настоящая оплата через банк: проект." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=18;fontColor=#64748B;" parent="1" vertex="1">
          <mxGeometry x="70" y="140" width="1580" height="80" as="geometry" />
        </mxCell>
        <mxCell id="02-open" value="Настройки → Подписка&#10;Текущий тариф, статус, срок&#10;«Добавлено X из N кабинетов»." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="630" y="280" width="460" height="156" as="geometry" />
        </mxCell>
        <mxCell id="02-choose" value="Выбрать тариф&#10;Соло: 1 / 1 990 ₽ в месяц&#10;Старт: до 5 / 4 990 ₽&#10;Бизнес: до 25 / 8 990 ₽&#10;Профи: до 50 / 14 990 ₽&#10;Более 50: по согласованию." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="630" y="556" width="460" height="240" as="geometry" />
        </mxCell>
        <mxCell id="02-pay" value="ЦЕЛЕВАЯ ОПЛАТА&#10;Создать платёж → платёжная страница&#10;→ сервер проверяет уведомление&#10;банка.&#10;Один возврат браузера не&#10;подтверждает оплату." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#FFE9D5;strokeColor=#C99768;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="883.3333333333335" y="1062" width="460" height="240" as="geometry" />
        </mxCell>
        <mxCell id="02-test" value="СЕЙЧАС ДЛЯ ТЕСТОВ&#10;«Активировать без оплаты»&#10;Тестовая подписка на 30 дней.&#10;Деньги не списываются." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#FFF0C9;strokeColor=#C99726;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="553.3333333333334" y="1422" width="460" height="184" as="geometry" />
        </mxCell>
        <mxCell id="02-active" value="Подписка активна&#10;Работа со своими заказами ·&#10;подключение клиентов · склады ·&#10;сотрудники · учёт.&#10;Права сотрудника проверяются&#10;отдельно." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#DFF4E4;strokeColor=#65A773;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="630" y="1726" width="460" height="240" as="geometry" />
        </mxCell>
        <mxCell id="02-limit" value="Лимит кабинетов&#10;Считаются уникальные свои и&#10;подключённые клиентские кабинеты.&#10;Несколько складов одного кабинета не&#10;равны нескольким API-ключам." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="70" y="2086" width="460" height="212" as="geometry" />
        </mxCell>
        <mxCell id="02-renew" value="Продлить / сменить тариф&#10;Показать срок и новый лимит.&#10;Целевая логика: сохранить&#10;оплаченные дни; не отключать лишние&#10;кабинеты молча." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#FFE9D5;strokeColor=#C99768;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1190" y="2418" width="460" height="212" as="geometry" />
        </mxCell>
        <mxCell id="02-expired" value="Подписка истекла&#10;Рабочие действия ВМС закрыты.&#10;API-ключи, история и документы не&#10;удаляются.&#10;Настройки и профиль остаются." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#FFF0C9;strokeColor=#C99726;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="630" y="2086" width="460" height="212" as="geometry" />
        </mxCell>
        <mxCell id="02-free" value="БЕЗ СОБСТВЕННОЙ ПОДПИСКИ&#10;Можно добавить свой API и выдать&#10;доступ ФФ.&#10;Можно смотреть свой обзор&#10;подключённых ФФ.&#10;Нельзя работать как платный оператор&#10;ВМС." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#F5F6F8;strokeColor=#A5AFBE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="630" y="2418" width="460" height="268" as="geometry" />
        </mxCell>
        <mxCell id="02-staff" value="Сотруднику не нужна личная подписка&#10;Доступ по назначению на склад.&#10;Ограничение при истечении подписки&#10;работодателя." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#F5F6F8;strokeColor=#A5AFBE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="70" y="2418" width="460" height="184" as="geometry" />
        </mxCell>
        <mxCell id="02-edge-0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontColor=#233044;fontSize=18;fontFamily=Arial;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;exitPerimeter=0;entryPerimeter=0;" parent="1" edge="1" source="02-open" target="02-choose">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="02-edge-1" value="После подключения банка" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontColor=#233044;fontSize=18;fontFamily=Arial;labelBackgroundColor=#FFFFFF;exitX=0.6666666666666669;exitY=1.0;entryX=0.5;entryY=0.0;exitPerimeter=0;entryPerimeter=0;" parent="1" edge="1" source="02-choose" target="02-pay">
