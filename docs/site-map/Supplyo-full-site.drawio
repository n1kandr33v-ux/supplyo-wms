  <diagram id="p16" name="16 · Работы сотрудников и зарплата">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title-16" value="16 · Работы сотрудников и зарплата" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=34;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="70" y="20" width="1687" height="65" as="geometry" />
        </mxCell>
        <mxCell id="scope-16" value="Владелец / управляющий с финансовыми правами" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=21;fontColor=#64748B;" parent="1" vertex="1">
          <mxGeometry x="70" y="90" width="1687" height="45" as="geometry" />
        </mxCell>
        <mxCell id="status-16" value="Реализация: Учёт работ и выплат есть; это запись расчёта, а не банковский перевод." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=18;fontColor=#64748B;" parent="1" vertex="1">
          <mxGeometry x="70" y="140" width="1687" height="80" as="geometry" />
        </mxCell>
        <mxCell id="16-scope" value="УЧЁТ → РАБОТЫ СОТРУДНИКОВ&#10;Выбран физический склад и период." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1143.3333333333333" y="280" width="460" height="130" as="geometry" />
        </mxCell>
        <mxCell id="16-new" value="ДОБАВИТЬ РАБОТУ ЗА ДЕНЬ&#10;Дата + сотрудник из списка этого&#10;склада.&#10;Не вводить произвольное имя вместо&#10;сотрудника." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1143.3333333333333" y="530" width="460" height="212" as="geometry" />
        </mxCell>
        <mxCell id="16-lines" value="СПИСОК РАБОТ&#10;Несколько строк: работа + количество&#10;+ ставка.&#10;Например: сборка, упаковка, КИЗ,&#10;приёмка." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1143.3333333333333" y="862" width="460" height="212" as="geometry" />
        </mxCell>
        <mxCell id="16-sum" value="РАСЧЁТ&#10;Сумма строки = количество × ставка.&#10;Итого за день = сумма всех строк." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1143.3333333333333" y="1194" width="460" height="156" as="geometry" />
        </mxCell>
        <mxCell id="16-group" value="ОДИН СОТРУДНИК + ОДИН ДЕНЬ&#10;Все его работы объединяются в одну&#10;запись с раскрываемым списком." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1143.3333333333333" y="1470" width="460" height="156" as="geometry" />
        </mxCell>
        <mxCell id="16-edit" value="РЕДАКТИРОВАНИЕ&#10;Исправить список и документы.&#10;После оплаты — корректировка с&#10;сохранением согласованности учёта." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="660" y="1746" width="460" height="184" as="geometry" />
        </mxCell>
        <mxCell id="16-due" value="К ВЫПЛАТЕ&#10;Показать неоплаченные работы.&#10;В «Зарплате» — начислено /&#10;выплачено / осталось по сотруднику." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1220" y="1746" width="460" height="184" as="geometry" />
        </mxCell>
        <mxCell id="16-pay" value="ОТМЕТИТЬ ВЫПЛАТУ&#10;Выбрать сотрудника и оплачиваемые&#10;работы.&#10;Сохранить дату и сумму выплаты." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E2F1FF;strokeColor=#5197CE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1220" y="2050" width="460" height="184" as="geometry" />
        </mxCell>
        <mxCell id="16-expense" value="РАСХОД ПО ЗАРПЛАТЕ → 15&#10;За одного сотрудника в день выплаты&#10;объединить работы.&#10;Не создавать по расходу на каждую&#10;строку." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#DFF4E4;strokeColor=#65A773;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="736.6666666666666" y="2354" width="460" height="212" as="geometry" />
        </mxCell>
        <mxCell id="16-paid" value="ВЫПЛАЧЕНО&#10;В фильтре «К выплате» строка&#10;исчезает.&#10;В истории / «Все» остаётся и доступна&#10;для просмотра." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#DFF4E4;strokeColor=#65A773;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1296.6666666666665" y="2354" width="460" height="212" as="geometry" />
        </mxCell>
        <mxCell id="16-money" value="ДЕНЬГИ ПЕРЕВОДЯТСЯ ОТДЕЛЬНО&#10;Кнопка фиксирует выплату в учёте.&#10;Автоматические банковские выплаты в&#10;сценарий не включены." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#F5F6F8;strokeColor=#A5AFBE;strokeWidth=2;fontColor=#233044;fontSize=20;fontFamily=Arial;spacing=24;align=center;verticalAlign=middle;" parent="1" vertex="1">
